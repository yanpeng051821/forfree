<view wx:if="{{authenticated}}" class="page editor">
  <view wx:if="{{templateNotice}}" class="template-sync">{{templateNotice}}<text bindtap="retryTemplate" hover-class="press">重试</text></view><view wx:if="{{draftTrashed}}" class="notice"><text>原草稿已保留。</text><text class="link" bindtap="openTrash">打开回收站</text></view><view wx:if="{{loading}}" class="loading-line">加载中…</view>
  <view wx:if="{{conflictReview.length}}" class="card conflict-review"><view class="section-title">核对版本冲突</view><view wx:for="{{conflictReview}}" wx:key="key" class="conflict-item"><text>{{item.label}}</text><view class="muted">本机：{{item.local}}</view><view class="muted">云端：{{item.remote}}</view></view><view class="actions"><button class="secondary" data-value="remote" bindtap="resolveVersion" hover-class="button-pressed" hover-stay-time="80">使用云端冲突值</button><button class="primary" data-value="local" bindtap="resolveVersion" hover-class="button-pressed" hover-stay-time="80">保留本机冲突值</button></view></view><view wx:if="{{legacyEstimates.length}}" class="notice">旧估算，仅供重新核对：<text wx:for="{{legacyEstimates}}" wx:key="label">{{item.label}} {{item.value}}；</text></view><view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
  <view wx:if="{{pending}}" class="notice pending-notice">上次保存待确认，重试会核查同一条记录。</view>
  <view wx:if="{{merchantRequired}}" class="empty"><view class="name">先选择商户</view><button class="primary" bindtap="chooseMerchant" hover-class="button-pressed" hover-stay-time="80">选择商户</button></view>
  <block wx:if="{{ready}}">
    <view wx:if="{{merchantLocked}}" class="recording-merchant" aria-label="当前商户">{{fields.supplier}}</view>
    <view class="photo-section"><scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="photo-scroll"><view class="photo-track {{photos.length ? '' : 'photo-empty'}}"><view wx:for="{{photos}}" wx:key="viewKey" class="ph"><image wx:if="{{item.path}}" class="ph-img" src="{{item.path}}" mode="aspectFill" data-index="{{index}}" bindtap="preview" /><view wx:else class="ph-img ph-missing"><image class="icon" src="/assets/icons/image.png" /></view><view wx:if="{{index === 0}}" class="ph-cover">封面</view><view class="ph-x" data-index="{{index}}" catchtap="removePhoto" aria-label="删除照片" hover-class="press" hover-stay-time="80">×</view><view wx:if="{{index !== 0}}" class="ph-main" data-index="{{index}}" catchtap="mainPhoto" hover-class="press" hover-stay-time="80">设为封面</view></view><view wx:if="{{photos.length < 6}}" class="ph ph-add" bindtap="addPhotos" hover-class="press" aria-role="button" aria-label="拍照或从相册添加"><image class="icon lg" src="/assets/icons/camera.png" /><text class="photo-limit num">{{photos.length}} / 6</text></view></view></scroll-view></view>
    <view class="capture-note">
      <textarea aria-label="现场描述或补充记录" auto-height value="{{fields.description}}" disabled="{{saving}}" maxlength="10000" data-key="description" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="记下报价、规格或待问事项…" />
      <view class="note-tools row between"><view class="icon-button" bindtap="showOrganizeInfo" aria-role="button" aria-label="AI 整理说明" hover-class="press" hover-stay-time="80"><text class="info-icon">i</text></view><button wx:if="{{capabilityFailed}}" class="organize-action" bindtap="retryCapabilities" disabled="{{capabilityChecking}}" hover-class="button-pressed" hover-stay-time="80">重试</button><button wx:else class="organize-action" disabled="{{saving || recognizing || !modelKnown}}" loading="{{recognizing}}" bindtap="organize" hover-class="button-pressed" hover-stay-time="80"><image wx:if="{{!recognizing}}" class="icon sm" src="/assets/icons/spark-green.png" />{{recognizing ? '整理中' : 'AI 整理'}}</button></view>
    </view>
    <view wx:if="{{notice}}" class="notice extraction-notice">{{notice}}</view>
    <view class="editor-section core-fields">
      <view class="section-header row between"><text>商品</text><view class="row"><text wx:if="{{fields.confirmed}}" class="confirm-state ok">已核对</text><view class="icon-button" bindtap="favorite" aria-role="button" aria-label="{{fields.favorite ? '取消收藏' : '收藏商品'}}" hover-class="press" hover-stay-time="80"><image class="icon" src="/assets/icons/{{fields.favorite ? 'heart-filled' : 'heart'}}.png" /></view></view></view>
<view class="field {{fieldError && fieldError.key === 'name' ? 'has-error' : ''}}" id="field-name"><text class="label">名称<text wx:if="{{estimatedFields.name}}" class="estimate-label">估算 · 待核对</text></text><input value="{{fields.name}}" disabled="{{saving}}" maxlength="120" data-key="name" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="{{autoOrganize && !editing ? '商品名称，可由 AI 补齐' : '商品名称 · 必填'}}" /><view wx:if="{{fieldError && fieldError.key === 'name'}}" class="field-error">{{fieldError.message}}</view></view>
      <view class="grid2 price-quantity">
        <view class="field" id="field-unitPrice"><view class="price-label"><text class="label">{{fieldLabels.unitPrice || '单价'}}</text><picker range="{{currencies}}" value="{{currencyIndex}}" disabled="{{saving}}" bindchange="currency"><view class="currency-inline">{{fields.currency}}⌄</view></picker></view><input type="digit" value="{{fields.unitPrice}}" disabled="{{saving}}" data-key="unitPrice" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="待询价" /><view wx:if="{{fieldError && fieldError.key === 'unitPrice'}}" class="field-error">{{fieldError.message}}</view></view>
        <view class="field" id="field-quantity"><text class="label">{{fieldLabels.quantity || '采购数量'}} · 件</text><input type="number" value="{{fields.quantity}}" disabled="{{saving}}" data-key="quantity" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="{{captureTotals.derivedQuantity !== null ? captureTotals.derivedQuantity + '（箱数 × 每箱）' : '待确认'}}" /><view wx:if="{{fieldError && fieldError.key === 'quantity'}}" class="field-error">{{fieldError.message}}</view></view>
      </view>
      <view wx:if="{{captureTotals.amount !== ''}}" class="capture-total"><text>金额</text><text>{{fields.currency}} {{captureTotals.amount}}</text></view>
      <view wx:if="{{captureTotals.quantityMismatch}}" class="quantity-warning">数量与箱数 × 每箱数量不一致；导出采用填写的采购数量。</view>
      <view class="grid2"><view class="field" id="field-sku"><text class="label">{{fieldLabels.sku || '型号 / 货号'}}<text wx:if="{{estimatedFields.sku}}" class="estimate-label">估算 · 待核对</text></text><input value="{{fields.sku}}" disabled="{{saving}}" maxlength="120" data-key="sku" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="型号 / 货号" /></view><view class="field" id="field-colors"><text class="label">颜色<text wx:if="{{estimatedFields.colors}}" class="estimate-label">估算 · 待核对</text></text><input value="{{fields.colors}}" disabled="{{saving}}" maxlength="200" data-key="colors" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="待补" /></view></view>
      <view wx:if="{{fieldVisible.exportRemarks !== false || fields.exportRemarks}}" class="field"><text class="label">商品说明 / 对外备注</text><textarea class="notes-input" auto-height value="{{fields.exportRemarks}}" disabled="{{saving}}" maxlength="5000" data-key="exportRemarks" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="随示例表格的备注列分享，例如包装、标签要求" /></view>
      <view wx:if="{{customInputs.length}}" class="custom-fields"><view wx:for="{{customInputs}}" wx:key="key" class="field"><text class="label">{{item.label}}</text><input value="{{item.value}}" disabled="{{saving}}" maxlength="2000" data-key="{{item.key}}" bindinput="customInput" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="待补" /></view></view>
      <view class="product-extras">
      <view class="section-header row between details-toggle" bindtap="toggleDetails" aria-role="button" aria-expanded="{{detailsOpen}}" hover-class="press" hover-stay-time="80"><view class="row"><view><text>规格与包装</text><view wx:if="{{!detailsOpen && specSummary}}" class="fold-summary">{{specSummary}}</view></view><text wx:if="{{filledCount}}" class="section-count">已补 {{filledCount}} 项</text></view><text class="fold-symbol">{{detailsOpen ? '−' : '+'}}</text></view>
      <view wx:if="{{detailsOpen}}" class="details-fields">
<view class="grid2"><view class="field" id="field-cartons"><text class="label">{{fieldLabels.cartons || '箱数'}}</text><input type="number" value="{{fields.cartons}}" disabled="{{saving}}" data-key="cartons" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="待确认" /></view><view class="field" id="field-cartonQty"><text class="label">{{fieldLabels.cartonQty || '每箱数量'}}</text><input type="number" value="{{fields.cartonQty}}" disabled="{{saving}}" data-key="cartonQty" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="待补" /></view></view>
<view class="grid2"><view class="field {{fieldError && fieldError.key === 'moq' ? 'has-error' : ''}}" id="field-moq"><text class="label">起订量 · 件<text wx:if="{{estimatedFields.moq}}" class="estimate-label">估算 · 待核对</text></text><input type="number" value="{{fields.moq}}" disabled="{{saving}}" maxlength="200" data-key="moq" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="待询" /><view wx:if="{{fieldError && fieldError.key === 'moq'}}" class="field-error">{{fieldError.message}}</view></view><view class="field" id="field-material"><text class="label">材质</text><input value="{{fields.material}}" disabled="{{saving}}" maxlength="200" data-key="material" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="待补" /></view></view><view class="field" id="field-dimensions"><text class="label">商品尺寸<text wx:if="{{estimatedFields.dimensions}}" class="estimate-label">估算 · 待核对</text></text><input value="{{fields.dimensions}}" disabled="{{saving}}" maxlength="200" data-key="dimensions" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="含单位" /></view><view class="grid2"><view class="field {{fieldError && fieldError.key === 'weightG' ? 'has-error' : ''}}" id="field-weightG"><text class="label">单件重量 · g<text wx:if="{{estimatedFields.weightG}}" class="estimate-label">估算 · 待核对</text></text><input type="digit" value="{{fields.weightG}}" disabled="{{saving}}" maxlength="200" data-key="weightG" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="待补" /><view wx:if="{{fieldError && fieldError.key === 'weightG'}}" class="field-error">{{fieldError.message}}</view></view><view class="field {{fieldError && fieldError.key === 'leadTimeDays' ? 'has-error' : ''}}" id="field-leadTimeDays"><text class="label">交期 · 天<text wx:if="{{estimatedFields.leadTimeDays}}" class="estimate-label">估算 · 待核对</text></text><input type="number" value="{{fields.leadTimeDays}}" disabled="{{saving}}" maxlength="200" data-key="leadTimeDays" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="待确认" /><view wx:if="{{fieldError && fieldError.key === 'leadTimeDays'}}" class="field-error">{{fieldError.message}}</view></view></view><view class="field" id="field-cartonDimensions"><text class="label">外箱尺寸<text wx:if="{{estimatedFields.cartonDimensions}}" class="estimate-label">估算 · 待核对</text></text><input value="{{fields.cartonDimensions}}" disabled="{{saving}}" maxlength="200" data-key="cartonDimensions" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="长 × 宽 × 高，含单位" /></view><view class="field {{fieldError && fieldError.key === 'cartonCbm' ? 'has-error' : ''}}" id="field-cartonCbm"><text class="label">单箱体积 · m³<text wx:if="{{estimatedFields.cartonCbm}}" class="estimate-label">估算 · 待核对</text></text><input type="digit" value="{{fields.cartonCbm}}" disabled="{{saving}}" maxlength="200" data-key="cartonCbm" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="待补" /><view wx:if="{{fieldError && fieldError.key === 'cartonCbm'}}" class="field-error">{{fieldError.message}}</view></view><view wx:if="{{fieldVisible.barcode || fields.barcode}}" class="field" id="field-barcode"><text class="label">{{fieldLabels.barcode || '条码'}}</text><input value="{{fields.barcode}}" disabled="{{saving}}" maxlength="200" data-key="barcode" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="待补" /></view><view wx:if="{{captureTotals.cbm !== null}}" class="capture-total"><text>总体积 · m³</text><text>{{captureTotals.cbm}}</text></view><view class="field" id="field-tradeTerms"><text class="label">报价条款<text wx:if="{{estimatedFields.tradeTerms}}" class="estimate-label">估算 · 待核对</text></text><input value="{{fields.tradeTerms}}" disabled="{{saving}}" maxlength="200" data-key="tradeTerms" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="出厂价 / 含税价 / FOB…" /></view>
      </view>
      </view>
    </view>
    <view class="editor-section supplier-section">
      <view class="section-header row between"><text>商户</text><picker wx:if="{{suppliers.length && !merchantLocked}}" range="{{suppliers}}" disabled="{{saving}}" bindchange="supplier"><view class="merchant-switch" aria-label="切换已记录商户或新商户"><text>{{fields.supplier ? '换店' : '选择商户'}}</text><image class="icon sm" src="/assets/icons/switch.png" /></view></picker></view>
<view wx:if="{{fields.supplier && !supplierOpen}}" class="merchant-summary" bindtap="toggleSupplier" aria-label="修改当前商家资料" aria-role="button" hover-class="control-pressed"><view class="row between"><text>{{fields.supplier}}</text><image class="icon sm" src="/assets/icons/chevron.png" /></view><view wx:if="{{fields.supplierContact}}" class="merchant-contact">{{fields.supplierContact}}</view></view>
      <block wx:else><view class="field" id="field-supplier"><text class="label">名称 / 摊位<text wx:if="{{estimatedFields.supplier}}" class="estimate-label">估算 · 待核对</text></text><input value="{{fields.supplier}}" disabled="{{saving || merchantLocked}}" maxlength="200" data-key="supplier" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="商户名称或摊位号" /></view>
      <view class="field" id="field-supplierContact"><text class="label">联系方式</text><input value="{{fields.supplierContact}}" disabled="{{saving}}" maxlength="200" data-key="supplierContact" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="手机 / 微信 / 联系人" /></view></block>
    </view>
    <view class="editor-section">
      <view class="section-header"><text>评价与备注</text></view>
      <view class="rating-stars"><view wx:for="{{stars}}" wx:key="*this" class="rating-star {{fields.rating >= item ? 'rated' : ''}}" data-value="{{item}}" bindtap="rate" aria-role="button" aria-label="{{item}}星" hover-class="press">★</view></view>
      <textarea class="notes-input" auto-height value="{{fields.evaluation}}" disabled="{{saving}}" maxlength="5000" data-key="evaluation" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="你的选品评价" />
      <textarea class="notes-input" auto-height value="{{fields.notes}}" disabled="{{saving}}" maxlength="5000" data-key="notes" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" placeholder="内部备注、待问事项" />
    </view>
    <view class="editor-save-note"><text>{{draftNotice}}</text><view class="icon-button" bindtap="moreActions" aria-role="button" aria-label="更多商品操作" hover-class="press"><text class="more-symbol">···</text></view></view>
    <view wx:if="{{!editing}}" class="auto-organize-row"><text>保存后后台整理</text><switch checked="{{autoOrganize}}" disabled="{{saving}}" bindchange="toggleAutoOrganize" color="#263b32" aria-label="保存后后台整理图片与描述" /></view>
    <view class="save-float" style="bottom:calc({{keyboardHeight}}px + 28rpx + env(safe-area-inset-bottom))"><button class="save-orb" disabled="{{saving || recognizing}}" loading="{{saving && !continuing}}" bindtap="saveBack" aria-label="保存并返回商品列表" hover-class="orb-pressed"><image wx:if="{{!saving || continuing}}" src="/assets/icons/save-white.png" /></button><button class="save-orb" disabled="{{saving || recognizing}}" loading="{{saving && continuing}}" bindtap="saveNext" aria-label="保存并继续记录新品" hover-class="orb-pressed"><image wx:if="{{!saving || !continuing}}" src="/assets/icons/save-next-white.png" /></button></view>

  </block>
  <view wx:if="{{!ready && !loading && error && !draftBroken && !draftTrashed}}" class="empty"><button class="primary" bindtap="open" hover-class="button-pressed" hover-stay-time="80">重试</button><button class="secondary recovery-back" bindtap="backToProducts" hover-class="button-pressed" hover-stay-time="80">返回商品</button></view>
  <view wx:if="{{draftBroken}}" class="discard-wrap"><button class="secondary" bindtap="discard" hover-class="button-pressed" hover-stay-time="80">放弃损坏草稿</button></view>
</view>
