.tasks-page{padding-top:10rpx}.task-list-head{height:64rpx;margin-bottom:4rpx}.task-list-head .muted{font-size:23rpx}.task-list-head .icon-button{margin-right:-16rpx}.task-row{display:flex;align-items:center;padding:32rpx 0;border-bottom:1rpx solid #e9ebee;gap:12rpx}.task-row:last-of-type{border:0}.task-body{flex:1;min-width:0;padding-left:2rpx}.task-date{font-size:21rpx;color:#a0a4ab;letter-spacing:1rpx}.task-name{font-size:33rpx;font-weight:600;margin:9rpx 0 8rpx;line-height:1.5}.current-dot{vertical-align:middle;margin-left:14rpx}.task-market{font-size:24rpx;color:#93979e}.task-counts{display:flex;gap:9rpx;align-items:baseline;margin-top:24rpx;color:#9ba0a6;font-size:22rpx}.task-total{font-size:31rpx;font-weight:500;color:#484d54}.task-pending{color:#b58a56;font-size:21rpx;padding-left:20rpx}.task-tools{display:flex;flex-direction:column;gap:6rpx;margin-right:-16rpx}.task-tools .icon-button{width:68rpx;height:68rpx}.task-tools .icon{width:31rpx;height:31rpx}.task-tools .icon.sm{width:24rpx;height:24rpx}.create-form{background:#fff;border-radius:24rpx;padding:28rpx;margin:4rpx 0 20rpx}.create-form .field{margin-bottom:28rpx}

.demo-label{font-size:19rpx;margin-left:16rpx;letter-spacing:0;color:#a3a9b1}

.task-row{padding:30rpx 0;align-items:flex-start}.task-name{font-size:34rpx;letter-spacing:-.5rpx;margin:8rpx 0}.task-counts{margin-top:16rpx}.task-tools{margin-top:25rpx}.task-pending{padding-left:12rpx}.task-date{color:#747e89}.task-market{color:#737d88}.task-counts{color:#737d88}.task-counts .task-total{color:#202226}

.tasks-page{padding-bottom:calc(156rpx + env(safe-area-inset-bottom))}.task-list-head{display:flex;align-items:center}.create-orb{position:fixed;right:28rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));z-index:10;width:106rpx;height:106rpx;min-width:106rpx;max-width:106rpx;min-height:106rpx;flex:0 0 106rpx;padding:0;margin:0;border:5rpx solid #fafafa;border-radius:50%;background:#263b32;color:#fff;box-shadow:0 8rpx 24rpx rgba(31,54,40,.16)}.create-orb .plus-icon{font-size:54rpx}.create-orb .close-icon{color:#fff;font-size:46rpx}.create-orb-pressed{transform:scale(.92);background:#3b5645}

.create-overlay{position:fixed;top:0;right:0;left:0;z-index:30;display:flex;align-items:center;justify-content:center;padding:24rpx}.create-backdrop{position:absolute;inset:0;background:rgba(24,32,27,.32)}.create-card{position:relative;width:100%;max-width:650rpx;background:#fff;border-radius:30rpx;box-shadow:0 20rpx 64rpx rgba(22,36,27,.12);overflow:hidden;animation:create-appear 140ms ease-out}.create-heading{position:relative;display:flex;align-items:center;min-height:100rpx;padding:22rpx 100rpx 20rpx 32rpx;font-size:32rpx;font-weight:600;color:#263b32}.create-close{position:absolute;right:20rpx;top:16rpx;width:68rpx;max-width:68rpx;min-width:68rpx;height:68rpx;padding:0;margin:0;background:transparent;border-radius:50%;flex:0 0 68rpx}.create-close .close-icon{font-size:38rpx;color:#87938b}.create-fields{width:100%}.create-fields .field{margin:0 32rpx 24rpx}.create-fields input{background:#f2f5f3;height:82rpx;font-size:27rpx}.create-fields .label{font-size:23rpx;margin-bottom:10rpx;color:#78867c}.create-date{display:flex;justify-content:space-between;align-items:center;padding:4rpx 32rpx 12rpx;font-size:24rpx;color:#78867c;min-height:70rpx}.create-date-value{display:flex;align-items:center;gap:16rpx;padding:12rpx 0;color:#344b3c;font-size:25rpx}.create-date .icon{width:20rpx;height:20rpx;opacity:.45}.create-footer{padding:20rpx 32rpx 32rpx;background:#fff}.create-footer .primary{width:100%;min-width:0;margin:0;height:84rpx;background:#263b32;border-radius:16rpx}.create-error,.create-notice{margin:0 32rpx 20rpx;font-size:23rpx;line-height:1.5;color:#a7743e}.create-notice{color:#758278}.create-error{padding:14rpx 18rpx;background:#fff6ed;border-radius:12rpx}@keyframes create-appear{from{opacity:0;transform:translateY(12rpx) scale(.98)}to{opacity:1;transform:none}}

.task-list-head{display:flex;justify-content:space-between;align-items:center}.task-list-head .icon-button{width:64rpx;height:64rpx;min-width:64rpx;min-height:64rpx}.task-list-head .icon{width:28rpx;height:28rpx;opacity:.6}

