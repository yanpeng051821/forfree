.me-page{background:#f5f7f5;padding:24rpx 28rpx 52rpx}.account-section{display:flex;align-items:center;gap:24rpx;width:100%;height:auto;min-height:188rpx;padding:20rpx 6rpx 34rpx;margin:0;background:transparent;text-align:left;justify-content:flex-start;border-radius:22rpx}.account-avatar{width:116rpx;height:116rpx;flex:0 0 116rpx;background:#e3ebe5;border-radius:35rpx;display:flex;align-items:center;justify-content:center;color:#597363;font-size:45rpx;font-weight:500;overflow:hidden}.account-avatar image{width:100%;height:100%}.account-copy{flex:1;min-width:0}.account-name{font-size:38rpx;font-weight:600;line-height:1.35;color:#23382c;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.account-status{font-size:23rpx;color:#839087;margin-top:12rpx;font-weight:400;line-height:1.5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.account-chevron{width:26rpx;height:26rpx;opacity:.4;flex-shrink:0}.personal-library{background:#fff;border-radius:24rpx;margin-bottom:22rpx;overflow:hidden;padding:4rpx 0}.library-row{min-height:108rpx;padding:22rpx 24rpx;display:flex;align-items:center;gap:20rpx;font-size:28rpx;color:#35483b;position:relative}.library-row:not(:last-child)::after{content:'';position:absolute;left:84rpx;right:24rpx;bottom:0;height:1rpx;background:#eef2ef}.menu-icon{display:flex;align-items:center;justify-content:center;width:44rpx;height:44rpx;flex:0 0 44rpx}.menu-icon image{width:34rpx;height:34rpx;opacity:.72}.currency-symbol{font-size:31rpx;color:#637b6a}.menu-description{font-size:21rpx;color:#97a199;margin-top:6rpx}.chevron{width:22rpx;height:22rpx;opacity:.35;flex-shrink:0}.setting-value{font-size:24rpx;color:#86948a}.row-pressed{background:#eaf0ec}.draft-section{margin-top:28rpx;margin-bottom:24rpx}.list-heading{display:flex;justify-content:space-between;padding:0 8rpx 16rpx;color:#849288;font-size:23rpx}.draft-list{background:#fff;border-radius:22rpx;overflow:hidden}.draft-item{padding:20rpx 24rpx;display:flex;align-items:center;gap:20rpx;border-bottom:1rpx solid #eef2ef}.draft-item:last-child{border:0}.draft-thumb{display:flex;align-items:center;justify-content:center;background:#eef2ef;width:84rpx;height:88rpx;border-radius:16rpx;flex:0 0 84rpx;overflow:hidden}.draft-thumb image{width:100%;height:100%}.draft-thumb .draft-placeholder{width:32rpx;height:32rpx;opacity:.35}.draft-name{font-size:26rpx;color:#364b3d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.draft-meta{font-size:21rpx;color:#9aa49d;margin-top:8rpx}.settings-list{margin-top:16rpx;padding:0 4rpx}.setting-row{display:flex;align-items:center;gap:20rpx;min-height:88rpx;padding:18rpx 18rpx;border-radius:16rpx;font-size:25rpx;color:#819086}.logout-row{color:#94a097;margin-top:14rpx;font-size:23rpx}@media(max-width:360px){.me-page{padding-left:20rpx;padding-right:20rpx}.account-avatar{width:100rpx;height:100rpx;flex-basis:100rpx}.account-name{font-size:34rpx}}
