<view wx:if="{{authenticated}}" class="page export-page"><view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="load" hover-class="press" hover-stay-time="80">重试</view></view><view wx:if="{{dateControls}}" class="export-section export-dates"><text class="label">日期</text><view class="scope-options date-modes"><view class="{{dateMode === 'day' ? 'scope-active' : ''}}" data-mode="day" bindtap="changeDateMode" hover-class="press">单日</view><view class="{{dateMode === 'range' ? 'scope-active' : ''}}" data-mode="range" bindtap="changeDateMode" hover-class="press">{{rangeChecking ? '正在确认…' : '日期范围'}}</view></view><picker wx:if="{{dateMode === 'day'}}" mode="date" value="{{selectedDate}}" end="{{today}}" disabled="{{exporting}}" data-key="date" bindchange="dateChange"><view class="export-date-value row between"><text>{{selectedDate}}</text><image class="icon sm" src="/assets/icons/calendar.png" /></view></picker><view wx:else class="export-date-range"><picker mode="date" value="{{dateFrom}}" end="{{dateTo || today}}" disabled="{{exporting}}" data-key="dateFrom" bindchange="dateChange"><view class="export-date-value"><text class="date-caption">开始日期</text><view class="row between"><text>{{dateFrom}}</text><image class="icon sm" src="/assets/icons/calendar.png" /></view></view></picker><picker mode="date" value="{{dateTo}}" start="{{dateFrom}}" end="{{today}}" disabled="{{exporting}}" data-key="dateTo" bindchange="dateChange"><view class="export-date-value"><text class="date-caption">结束日期</text><view class="row between"><text>{{dateTo}}</text><image class="icon sm" src="/assets/icons/calendar.png" /></view></view></picker></view><view wx:if="{{dateNotice}}" class="date-notice">{{dateNotice}}</view></view><block wx:if="{{project}}"><view class="export-context"><view class="export-task">{{project.name}}</view><view class="export-meta num">{{loading ? '—' : exportCount}} 件商品 · {{merchantCount === null ? '—' : merchantCount}} 家商户</view></view>
  <view class="export-section"><text class="label">内容</text><view class="scope-options"><view class="{{audience === 'selection' ? 'scope-active' : ''}}" data-value="selection" bindtap="audience" hover-class="press" hover-stay-time="80">商品表</view><view class="{{audience === 'internal' ? 'scope-active' : ''}}" data-value="internal" bindtap="audience" hover-class="press" hover-stay-time="80">内部记录</view></view><view class="audience-hint">{{audience === 'internal' ? '含现场原话、联系方式、备注与评价' : '商品与现场报价，不含内部评价和现场原话'}}</view></view><view class="export-section"><text class="label">格式</text><view class="format-options"><view class="format-option {{images ? 'chosen' : ''}}" data-value="images" bindtap="format" hover-class="press" hover-stay-time="80"><view class="format-head row between"><text>带图表格</text><view class="radio {{images ? 'on' : ''}}" /></view><view class="format-detail">含商品图片</view></view><view class="format-option {{!images ? 'chosen' : ''}}" data-value="text" bindtap="format" hover-class="press" hover-stay-time="80"><view class="format-head row between"><text>纯数据表格</text><view class="radio {{!images ? 'on' : ''}}" /></view><view class="format-detail">仅文字与数字</view></view></view></view>
  <view class="export-section"><text class="label">范围</text><picker range="{{merchantOptions}}" value="{{merchantIndex}}" bindchange="merchant" disabled="{{loading || exporting}}"><view class="export-merchant row between"><text>{{supplierLabel}}</text><image class="icon sm" src="/assets/icons/chevron.png" /></view></picker><view class="scope-options"><view class="{{scope === 'all' ? 'scope-active' : ''}}" data-value="all" bindtap="scope" hover-class="press" hover-stay-time="80">全部商品</view><view class="{{scope === 'confirmed' ? 'scope-active' : ''}}" data-value="confirmed" bindtap="scope" hover-class="press" hover-stay-time="80">仅已核对</view></view></view>
  <view class="preview-section"><view wx:if="{{headerRows.length}}" class="export-company-header"><view wx:for="{{headerRows}}" wx:key="key" style="font-size: {{item.size * 2}}rpx; font-weight: {{item.bold ? '600' : '400'}}; text-align: {{item.align}};color:{{item.color || '#000000'}};font-family:{{item.font}};">{{item.text}}</view></view><view class="preview-heading row between"><text>预览</text><text class="muted">预览前 {{preview.length}} 件 · 共 {{exportCount}} 件</text></view><scroll-view wx:if="{{preview.length}}" scroll-x class="sheet-scroll" enhanced show-scrollbar="{{false}}"><view class="sheet" style="width:{{previewWidth}}rpx"><view class="sheet-row sheet-heading" style="{{previewFieldStyle}}"><view wx:for="{{templateColumns}}" wx:key="key" class="sheet-cell {{item.primary === false ? 'sheet-aux' : ''}}" style="width:{{item.previewWidth}}rpx">{{item.label}}</view></view><view wx:for="{{preview}}" wx:key="id" wx:for-item="product" class="sheet-row" style="{{previewBodyStyle}}"><view wx:for="{{product.cells}}" wx:key="key" class="sheet-cell {{item.primary === false ? 'sheet-aux' : ''}}" style="width:{{item.width}}rpx"><block wx:if="{{item.key === 'image'}}"><image wx:if="{{product.cover}}" src="{{product.cover}}" mode="aspectFit" /><text wx:else>—</text></block><text wx:else>{{item.value}}</text></view></view></view></scroll-view><view wx:else class="loading-line">{{loading ? '准备预览…' : '当前范围没有商品'}}<view wx:if="{{!loading}}" class="link" bindtap="returnToProducts" hover-class="press" hover-stay-time="80">返回商品</view></view><view class="export-details-link row between" bindtap="toggleColumns" aria-role="button" hover-class="press" hover-stay-time="80"><text>导出字段</text><text>{{columnsOpen ? '−' : '+'}}</text></view><view wx:if="{{columnsOpen}}" class="export-columns"><text wx:for="{{templateColumns}}" wx:key="key" class="tag">{{item.label}}</text></view></view>
  <view wx:if="{{drafts.length}}" class="draft-warning"><view class="draft-warning-title row"><text class="dot orange" /><text>{{supplierScoped ? '该商户还有 ' : '本机还有 '}}{{drafts.length}} 条未保存草稿，不在本次文件内</text></view><view wx:for="{{drafts}}" wx:key="draftKey" class="draft-export-item row between" data-index="{{index}}" bindtap="resume" hover-class="press" hover-stay-time="80"><text class="grow">{{item.fields.name || '未命名商品'}}</text><image class="icon sm" src="/assets/icons/chevron.png" /></view></view>
  <view wx:if="{{fileReady}}" class="file-ready"><image class="icon" src="/assets/icons/document.png" /><text>{{fileName}}</text></view><view class="toolbar"><view class="export-bottom row"><button class="secondary open-button" disabled="{{loading || exporting || !exportCount}}" bindtap="export" aria-label="打开 Excel" hover-class="button-pressed" hover-stay-time="80"><text>打开</text></button><button class="primary grow" disabled="{{loading || exporting || !exportCount}}" loading="{{exporting}}" data-share="yes" bindtap="export" hover-class="button-pressed" hover-stay-time="80">{{fileReady ? '再次分享' : '导出并分享'}}</button></view></view>
</block><view wx:if="{{loading && !project}}" class="loading-line">加载中…</view></view>
