<view class="value-control">
  <view class="value-heading"><text>{{label}}</text><text class="value-number">{{value}} <text class="value-unit">{{unit}}</text></text></view>
  <view class="slider-line"><button class="step-button" style="width:64rpx;min-width:64rpx;flex:0 0 64rpx;" hover-class="control-pressed" disabled="{{disabled || value <= min}}" data-direction="-1" bindtap="adjust" aria-label="减小{{label}}">−</button><slider class="value-slider" value="{{sliderValue}}" min="{{sliderMin}}" max="{{sliderMax}}" step="{{sliderStep}}" disabled="{{disabled}}" bindchanging="slide" bindchange="finish" activeColor="#263b32" backgroundColor="#e4e9e6" block-size="22" block-color="#ffffff" aria-label="滑动调整{{label}}" /><button class="step-button" style="width:64rpx;min-width:64rpx;flex:0 0 64rpx;" hover-class="control-pressed" disabled="{{disabled || value >= max}}" data-direction="1" bindtap="adjust" aria-label="增大{{label}}">+</button></view>
  <view wx:if="{{presets.length}}" class="value-presets"><button wx:for="{{presets}}" wx:key="*this" style="flex:1 1 0;width:0;min-width:0;" class="value-preset {{value === item ? 'chosen' : ''}}" hover-class="control-pressed" disabled="{{disabled}}" data-value="{{item}}" bindtap="choose" aria-label="{{label}}设为{{item}}{{unit}}">{{item}}</button></view>
</view>
