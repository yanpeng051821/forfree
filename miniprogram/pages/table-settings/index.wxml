<view wx:if="{{authenticated}}" class="page settings-page">
  <view wx:if="{{loading}}" class="loading-line">加载中…</view>
  <block wx:if="{{form}}">

    <view wx:if="{{draftNotice}}" class="draft-notice">{{draftNotice}}</view>
    <button wx:if="{{settingsNeedsReview}}" class="secondary review-action" bindtap="reviewLatest" disabled="{{saving || loading}}" hover-class="button-pressed" hover-stay-time="80">核对最新设置</button>
    <button wx:if="{{hasOldDraft}}" class="secondary review-action" bindtap="restoreOldDraft" disabled="{{saving || loading}}" hover-class="button-pressed" hover-stay-time="80">核对并恢复旧草稿</button>
    <view wx:if="{{settingsReview}}" class="conflict-review">
      <view class="section-title">{{settingsReview.oldDraft ? '旧草稿' : '本机'}} / 服务器 · 版本 {{settingsReview.version}}</view>
      <view wx:for="{{settingsReview.rows}}" wx:key="key" class="conflict-row"><text class="conflict-name">{{item.name}}</text><text>本机：{{item.local}}</text><text>服务器：{{item.latest}}</text></view>
      <view wx:if="{{!settingsReview.rows.length}}" class="notice">设置内容一致，仅版本变化。</view>
      <button class="secondary review-action" bindtap="acceptLatest" disabled="{{saving}}" hover-class="button-pressed" hover-stay-time="80">{{settingsReview.oldDraft ? '已核对，确认恢复旧草稿' : '已核对，保留本机并采用最新版本'}}</button>
    </view>
    <view class="table-preview">
      <button class="preview-title" bindtap="togglePreview" hover-class="press" aria-label="收起或展开实时预览"><view class="preview-summary"><text>实时预览</text><text class="muted">{{previews.length}} 行表头 · {{previewCount}} 列</text></view><image class="preview-chevron {{previewOpen ? 'opened' : ''}}" src="/assets/icons/chevron.png" /></button>
      <view wx:if="{{previewOpen}}" class="paper-preview">
        <view wx:for="{{previews}}" wx:key="key" class="preview-heading" style="{{item.previewStyle}}" data-index="{{item.index}}" bindtap="selectHeader" hover-class="press" aria-role="button" aria-label="编辑{{item.label}}">{{item.previewText}}</view>
        <scroll-view scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" class="preview-scroll"><view class="preview-sheet" style="width:{{previewTableWidth}}rpx"><view class="preview-field-row" style="{{previewFieldStyle}}"><view wx:for="{{previewColumns}}" wx:key="key" style="width:{{item.previewWidth}}rpx">{{item.label}}</view></view><view class="preview-body-row" style="{{previewBodyStyle}}"><view wx:for="{{previewColumns}}" wx:key="key" style="width:{{item.previewWidth}}rpx"><view wx:if="{{item.key === 'image'}}" class="preview-product-image"><image src="/assets/icons/image.png" /></view><text wx:else>{{item.previewValue}}</text></view></view></view></scroll-view>
        <view class="preview-total" style="{{previewTotalStyle}}">合计 <text>¥ 5,760.00</text></view><view class="preview-caption">示例数据 · 左右滑动查看全部列</view>
      </view>
    </view>
    <view class="group-tabs"><view class="group-tab-inner"><button wx:for="{{groups}}" wx:key="key" class="group-tab {{activeGroup === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="selectGroup" aria-label="{{item.label}}{{activeGroup === item.key ? '，当前选项' : ''}}" hover-class="button-pressed" hover-stay-time="80">{{item.label}}</button></view></view>
    <view wx:if="{{activeGroup === 'header'}}" class="settings-section">
      <view class="row between section-heading"><view class="section-title">多行表头</view><button class="quiet small" bindtap="addHeader" disabled="{{saving || headerRows.length >= 8}}" aria-label="增加表头行" hover-class="button-pressed" hover-stay-time="80">+ 添加行</button></view>
      <block wx:for="{{headerRows}}" wx:key="key">
        <button class="setting-summary {{headerEditing && activeHeader === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectHeader" aria-label="编辑{{item.label}}，{{item.enabled ? '显示' : '隐藏'}}" hover-class="button-pressed" hover-stay-time="80"><view class="summary-copy"><text class="summary-label">{{item.label}}</text><text class="summary-detail">{{item.enabled ? (item.content || '未填写') : '已隐藏'}}</text></view><text class="summary-end">{{headerEditing && activeHeader === index ? '编辑中' : '编辑'}}</text></button>
        <view wx:if="{{headerEditing && activeHeader === index && rowEditor}}" class="header-editor inline-editor">
          <view class="row between editor-heading"><text>{{rowEditor.label}}</text><button class="quiet small" bindtap="closeHeader" hover-class="button-pressed" hover-stay-time="80">收起</button></view>
          <view class="field"><text class="label">内容</text><textarea auto-height value="{{rowEditor.content}}" data-key="content" bindinput="headerInput" maxlength="500" disabled="{{saving}}" placeholder="填写这一行的内容" aria-label="{{rowEditor.label}}内容" /></view>
          <view wx:if="{{rowEditor.removable}}" class="settings-field"><text>行名称</text><input value="{{rowEditor.label}}" data-key="label" bindinput="headerInput" disabled="{{saving}}" maxlength="40" aria-label="表头行名称" /></view>
          <button class="disclosure" bindtap="toggleHeaderStyle" aria-label="{{headerStyleOpen ? '收起此行样式' : '编辑此行样式'}}" hover-class="button-pressed" hover-stay-time="80"><text>{{rowEditor.font}} · {{rowEditor.size}} pt · {{aligns[rowEditor.alignIndex]}}</text><text>{{headerStyleOpen ? '收起' : '样式'}}</text></button>
          <block wx:if="{{headerStyleOpen}}"><view class="inline-type-preview" style="font-family:{{rowEditor.font}};font-size:{{rowEditor.size * 2.5}}rpx;color:{{rowEditor.color || '#000000'}};font-weight:{{rowEditor.bold ? '700' : '400'}};text-align:{{rowEditor.align}}">{{rowEditor.content || rowEditor.label}}</view>
            <view class="settings-field"><text>字体</text><picker class="grow" range="{{fonts}}" value="{{rowEditor.fontIndex}}" data-key="font" bindchange="headerOption" disabled="{{saving}}" aria-label="表头字体"><view class="compact-picker">{{rowEditor.font}}<text>⌄</text></view></picker></view>
            <value-control label="字号" value="{{rowEditor.size}}" min="{{6}}" max="{{40}}" step="{{0.5}}" presets="{{[10,11,12,16,18,24,26]}}" data-key="size" bindchanging="headerSlide" bindchange="headerSlide" disabled="{{saving}}" />
            <value-control label="行高" value="{{rowEditor.height}}" min="{{10}}" max="{{120}}" step="{{0.5}}" unit="pt" data-key="height" bindchanging="headerSlide" bindchange="headerSlide" disabled="{{saving}}" />
            <color-control value="{{rowEditor.color || '#000000'}}" bindchange="headerColor" disabled="{{saving}}" />
            <view class="settings-field"><text>对齐</text><picker class="grow" range="{{aligns}}" value="{{rowEditor.alignIndex}}" data-key="align" bindchange="headerOption" disabled="{{saving}}" aria-label="表头对齐方式"><view class="compact-picker">{{aligns[rowEditor.alignIndex]}}<text>⌄</text></view></picker></view>
            <view class="row between option-row"><text>加粗</text><switch checked="{{rowEditor.bold}}" data-key="bold" bindchange="headerOption" disabled="{{saving}}" color="#28805a" aria-label="表头加粗" /></view>
          </block>
          <view class="row between option-row"><text>显示这一行</text><switch checked="{{rowEditor.enabled}}" data-key="enabled" bindchange="headerOption" disabled="{{saving || rowEditor.key === 'documentTitle'}}" color="#28805a" aria-label="显示表头行" /></view>
          <view class="row header-actions"><button class="secondary small" data-direction="-1" bindtap="moveHeader" disabled="{{saving || activeHeader === 0}}" aria-label="上移表头行" hover-class="button-pressed" hover-stay-time="80">上移</button><button class="secondary small" data-direction="1" bindtap="moveHeader" disabled="{{saving || activeHeader === headerRows.length - 1}}" aria-label="下移表头行" hover-class="button-pressed" hover-stay-time="80">下移</button><button wx:if="{{rowEditor.removable}}" class="quiet small" bindtap="removeHeader" disabled="{{saving}}" hover-class="button-pressed" hover-stay-time="80">移除</button></view>
        </view>
      </block>
    </view>
    <view wx:if="{{activeGroup === 'columns'}}" class="settings-section">
      <view class="row between"><view class="section-title">表格列 <text class="muted">{{previewCount}} 列显示</text></view><button class="quiet small" bindtap="useReferenceColumns" disabled="{{saving}}" hover-class="button-pressed">采用示例列</button></view><view class="notice">扩展列会同步到商品录入页。字段表头随显示列适配；移除列会保留商品中已填的数据。</view>
      <block wx:for="{{fields}}" wx:key="key">
        <button class="setting-summary {{activeColumn === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="selectColumn" aria-label="编辑{{item.label}}列" hover-class="button-pressed" hover-stay-time="80"><view class="summary-copy"><text class="summary-label">{{item.label}}</text><text class="summary-detail">{{item.required ? '必选' : (item.enabled ? '显示' : '隐藏')}} · 宽 {{item.widthText}}</text></view><text class="summary-end">{{activeColumn === item.key ? '收起' : '编辑'}}</text></button>
        <view wx:if="{{activeColumn === item.key}}" class="inline-editor">
          <view class="field"><text class="label">列名称</text><textarea auto-height value="{{item.label}}" data-index="{{index}}" bindinput="columnName" disabled="{{saving}}" maxlength="80" aria-label="列名称" /></view>
          <value-control label="列宽" unit="" value="{{item.width}}" min="{{5}}" max="{{80}}" step="{{0.5}}" presets="{{[8,12,16,20,24,32]}}" data-index="{{index}}" bindchanging="columnWidth" bindchange="columnWidth" disabled="{{saving}}" />
          <view class="row between option-row"><text>{{item.required ? '核心列必须保留' : '显示此列'}}</text><switch checked="{{item.enabled}}" data-index="{{index}}" bindchange="columnEnabled" disabled="{{saving || item.required}}" color="#28805a" aria-label="显示{{item.label}}列" /></view>
          <view class="row header-actions"><button class="secondary small" data-index="{{index}}" data-direction="-1" bindtap="moveColumn" disabled="{{saving || index === 0}}" aria-label="上移这一列" hover-class="button-pressed" hover-stay-time="80">上移</button><button class="secondary small" data-index="{{index}}" data-direction="1" bindtap="moveColumn" disabled="{{saving || index === fields.length - 1}}" aria-label="下移这一列" hover-class="button-pressed" hover-stay-time="80">下移</button></view>
        </view>
      </block>
      <view class="row between custom-title"><text>扩展列 <text class="muted">{{form.customFields.length}} / 8</text></text><button class="quiet small" bindtap="addCustom" disabled="{{saving || form.customFields.length >= 8}}" aria-label="新增自定义列" hover-class="button-pressed" hover-stay-time="80">+ 添加列</button></view>
      <block wx:for="{{form.customFields}}" wx:key="key">
        <button class="setting-summary {{activeCustom === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="selectCustom" aria-label="编辑扩展列{{item.label || '未命名'}}" hover-class="button-pressed" hover-stay-time="80"><view class="summary-copy"><text class="summary-label">{{item.label || '未命名扩展列'}}</text><text class="summary-detail">宽 {{item.width}}</text></view><text class="summary-end">{{activeCustom === item.key ? '收起' : '编辑'}}</text></button>
        <view wx:if="{{activeCustom === item.key}}" class="inline-editor">
          <view class="field"><text class="label">扩展列名称</text><input value="{{item.label}}" data-index="{{index}}" bindinput="customName" disabled="{{saving}}" maxlength="80" placeholder="例如客户货号" aria-label="扩展列名称" /></view>
          <value-control label="列宽" unit="" value="{{item.width}}" min="{{5}}" max="{{80}}" step="{{0.5}}" presets="{{[8,12,16,20,24,32]}}" data-index="{{index}}" bindchanging="customWidth" bindchange="customWidth" disabled="{{saving}}" />
          <view class="row header-actions"><button class="secondary small" data-index="{{index}}" data-direction="-1" bindtap="moveCustom" disabled="{{saving || index === 0}}" aria-label="上移扩展列" hover-class="button-pressed" hover-stay-time="80">上移</button><button class="secondary small" data-index="{{index}}" data-direction="1" bindtap="moveCustom" disabled="{{saving || index === form.customFields.length - 1}}" aria-label="下移扩展列" hover-class="button-pressed" hover-stay-time="80">下移</button><button class="quiet small" data-index="{{index}}" bindtap="removeCustom" disabled="{{saving}}" aria-label="移除自定义列" hover-class="button-pressed" hover-stay-time="80">移除</button></view>
        </view>
      </block>
    </view>
    <view wx:if="{{activeGroup === 'style'}}" class="settings-section">
      <view class="section-title">字体与字号</view>
      <view class="settings-field"><text>英文 / 数字</text><picker class="grow" range="{{fonts}}" value="{{latinIndex}}" data-key="latinFont" bindchange="layoutOption" disabled="{{saving}}" aria-label="英文与数字字体"><view class="compact-picker">{{form.layout.latinFont}}<text class="muted">⌄</text></view></picker></view>
      <view class="settings-field"><text>中文</text><picker class="grow" range="{{fonts}}" value="{{chineseIndex}}" data-key="chineseFont" bindchange="layoutOption" disabled="{{saving}}" aria-label="中文字体"><view class="compact-picker">{{form.layout.chineseFont}}<text class="muted">⌄</text></view></picker></view>
      <view class="type-card"><view class="inline-type-preview" style="font-size:{{form.layout.fieldSize * 2.5}}rpx;color:{{form.layout.fieldColor || '#000000'}};font-family:{{form.layout.chineseFont}}">商品名称 · 单价</view><value-control id="field-size-control" class="size-control" label="字段表头字号" value="{{form.layout.fieldSize}}" min="{{8}}" max="{{20}}" step="{{0.5}}" presets="{{[9,10,11,12,14,16]}}" data-key="fieldSize" bindchanging="layoutSlide" bindchange="layoutSlide" disabled="{{saving}}" /><color-control id="field-color-control" class="color-control" label="字段表头颜色" value="{{form.layout.fieldColor || '#000000'}}" data-key="fieldColor" bindchange="layoutColor" disabled="{{saving}}" /></view>
      <view class="type-card"><view class="inline-type-preview" style="font-size:{{form.layout.bodySize * 2.5}}rpx;color:{{form.layout.bodyColor || '#000000'}};font-family:{{form.layout.chineseFont}}">陶瓷杯 · ¥ 12.00</view><value-control id="body-size-control" class="size-control" label="商品内容字号" value="{{form.layout.bodySize}}" min="{{8}}" max="{{20}}" step="{{0.5}}" presets="{{[9,10,11,12,14,16]}}" data-key="bodySize" bindchanging="layoutSlide" bindchange="layoutSlide" disabled="{{saving}}" /><color-control id="body-color-control" class="color-control" label="商品内容颜色" value="{{form.layout.bodyColor || '#000000'}}" data-key="bodyColor" bindchange="layoutColor" disabled="{{saving}}" /></view>
      <view class="type-card"><view class="inline-type-preview" style="font-size:{{form.layout.totalSize * 2.5}}rpx;color:{{form.layout.totalColor || '#000000'}};font-family:{{form.layout.chineseFont}}">合计 · ¥ 5,760.00</view><value-control id="total-size-control" class="size-control" label="合计字号" value="{{form.layout.totalSize}}" min="{{8}}" max="{{20}}" step="{{0.5}}" presets="{{[9,10,11,12,14,16]}}" data-key="totalSize" bindchanging="layoutSlide" bindchange="layoutSlide" disabled="{{saving}}" /><color-control id="total-color-control" class="color-control" label="合计颜色" value="{{form.layout.totalColor || '#000000'}}" data-key="totalColor" bindchange="layoutColor" disabled="{{saving}}" /></view>
    </view>
    <view wx:if="{{activeGroup === 'print'}}" class="settings-section">
      <view class="section-title">版式与打印</view><view class="print-summary">{{paperLabels[paperIndex]}} · {{orientationLabels[orientationIndex]}} · {{printLabels[printIndex]}}</view><button class="disclosure" bindtap="toggleAdvanced" aria-label="{{advanced ? '收起版式选项' : '编辑版式与打印'}}" hover-class="button-pressed" hover-stay-time="80"><text>版式选项</text><text>{{advanced ? '收起' : '编辑'}}</text></button>
      <block wx:if="{{advanced}}">
        <value-control label="表头跨列" unit="列" value="{{form.layout.headerSpan}}" min="{{0}}" max="{{previewCount}}" data-key="headerSpan" bindchanging="layoutSlide" bindchange="layoutSlide" disabled="{{saving}}" /><view class="notice">0 为自动适配全部列。</view>
        <value-control label="字段行高" value="{{form.layout.fieldHeight}}" min="{{15}}" max="{{100}}" step="{{0.5}}" data-key="fieldHeight" bindchanging="layoutSlide" bindchange="layoutSlide" disabled="{{saving}}" />
        <value-control label="商品行高" value="{{form.layout.bodyHeight}}" min="{{40}}" max="{{300}}" data-key="bodyHeight" bindchanging="layoutSlide" bindchange="layoutSlide" disabled="{{saving}}" />
        <value-control label="多图行高" value="{{form.layout.multiImageHeight}}" min="{{60}}" max="{{409}}" data-key="multiImageHeight" bindchanging="layoutSlide" bindchange="layoutSlide" disabled="{{saving}}" />
        <view class="settings-field"><text>内容对齐</text><picker class="grow" range="{{aligns}}" value="{{alignmentIndex}}" data-key="alignment" bindchange="layoutOption" disabled="{{saving}}" aria-label="内容对齐方式"><view class="compact-picker">{{aligns[alignmentIndex]}}</view></picker></view>
        <view class="settings-field"><text>边框</text><picker class="grow" range="{{borderLabels}}" value="{{borderIndex}}" data-key="border" bindchange="layoutOption" disabled="{{saving}}" aria-label="边框样式"><view class="compact-picker">{{borderLabels[borderIndex]}}</view></picker></view>
        <value-control label="金额小数" unit="位" value="{{form.layout.moneyDecimals}}" min="{{0}}" max="{{6}}" presets="{{[0,1,2,3,4,6]}}" data-key="moneyDecimals" bindchanging="layoutSlide" bindchange="layoutSlide" disabled="{{saving}}" /><value-control label="体积小数" unit="位" value="{{form.layout.volumeDecimals}}" min="{{0}}" max="{{6}}" presets="{{[2,3,4,5,6]}}" data-key="volumeDecimals" bindchanging="layoutSlide" bindchange="layoutSlide" disabled="{{saving}}" />
        <view class="settings-field"><text>纸张</text><picker class="grow" range="{{paperLabels}}" value="{{paperIndex}}" data-key="paper" bindchange="layoutOption" disabled="{{saving}}" aria-label="纸张"><view class="compact-picker">{{paperLabels[paperIndex]}}</view></picker></view>
        <view class="settings-field"><text>方向</text><picker class="grow" range="{{orientationLabels}}" value="{{orientationIndex}}" data-key="orientation" bindchange="layoutOption" disabled="{{saving}}" aria-label="打印方向"><view class="compact-picker">{{orientationLabels[orientationIndex]}}</view></picker></view>
        <view class="settings-field"><text>缩放方式</text><picker class="grow" range="{{printLabels}}" value="{{printIndex}}" data-key="printMode" bindchange="layoutOption" disabled="{{saving}}" aria-label="打印缩放方式"><view class="compact-picker">{{printLabels[printIndex]}}</view></picker></view>
        <value-control wx:if="{{form.layout.printMode === 'scale'}}" label="打印比例" unit="%" value="{{form.layout.scale}}" min="{{10}}" max="{{100}}" presets="{{[50,65,75,85,100]}}" data-key="scale" bindchanging="layoutSlide" bindchange="layoutSlide" disabled="{{saving}}" />
        <view class="row between option-row"><text>每页重复表头</text><switch checked="{{form.layout.repeatHeader}}" data-key="repeatHeader" bindchange="layoutOption" disabled="{{saving}}" color="#28805a" aria-label="每页重复表头" /></view>
      </block>
    </view>
    <view wx:if="{{activeGroup === 'requirements'}}" class="settings-section"><view class="section-title">采购要求</view><view class="settings-field"><text>付款方式</text><input data-key="paymentTerms" value="{{form.paymentTerms}}" bindinput="input" disabled="{{saving}}" maxlength="500" placeholder="填写完整约定" aria-label="付款方式" /></view><view class="settings-field"><text>唛头</text><input data-key="shippingMark" value="{{form.shippingMark}}" bindinput="input" disabled="{{saving}}" maxlength="500" placeholder="选填" aria-label="唛头" /></view><view class="field"><text class="label">包装与标签要求</text><textarea data-key="packingRequirements" value="{{form.packingRequirements}}" bindinput="input" disabled="{{saving}}" maxlength="2000" placeholder="条码、外箱、贴标等常用要求" aria-label="包装与标签要求" /></view></view>
    <view wx:if="{{error}}" id="settings-error" class="error">{{error}}</view>
    <view class="toolbar"><view class="save-status">{{dirty ? '有未保存修改' : '已保存 · 后续导出沿用'}}</view><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving || loading || settingsNeedsReview}}" hover-class="button-pressed" hover-stay-time="80">保存设置</button></view>
  </block>
  <view wx:if="{{!form && error}}" class="error">{{error}}<button class="quiet small" bindtap="load" hover-class="button-pressed" hover-stay-time="80">重试</button></view>
</view>
