<view class="color-control"><view class="color-label">{{label}}</view><view class="color-options"><button wx:for="{{colors}}" wx:key="value" class="color-swatch {{selectedValue === item.value ? 'selected' : ''}}" style="background:{{item.value}};width:48rpx;min-width:48rpx;flex:0 0 48rpx;height:48rpx;" hover-class="swatch-pressed" data-value="{{item.value}}" bindtap="choose" disabled="{{disabled}}" aria-label="{{label}}，{{item.name}}" aria-pressed="{{selectedValue === item.value}}"><text wx:if="{{selectedValue === item.value}}">✓</text></button></view></view>
