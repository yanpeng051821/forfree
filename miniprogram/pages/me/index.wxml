<view wx:if="{{authenticated}}" class="page me-page">
  <view class="account-section" bindtap="editProfile" hover-class="press" aria-label="查看和编辑个人资料" aria-role="button"><view class="account-avatar"><image wx:if="{{avatarPreview}}" src="{{avatarPreview}}" mode="aspectFill" /><text wx:else>{{avatarInitial}}</text></view><view class="account-copy"><view class="account-name">{{profile.name || '个人资料'}}</view><view class="account-status">{{profile.company || '添加公司 / 商号'}}<text wx:if="{{profile.company}}"> · {{roleName}}</text></view></view><image class="account-chevron" src="/assets/icons/chevron.png" /></view>
  <view class="personal-library"><view class="library-row" bindtap="favorites" hover-class="row-pressed" aria-role="button" aria-label="打开我的收藏"><view class="menu-icon"><image src="/assets/icons/heart.png" /></view><text class="grow">我的收藏</text><image class="chevron" src="/assets/icons/chevron.png" /></view><view class="library-row" bindtap="trash" hover-class="row-pressed" aria-role="button" aria-label="打开回收站"><view class="menu-icon"><image src="/assets/icons/restore.png" /></view><view class="grow"><view>回收站</view><view class="menu-description">恢复移出的商品</view></view><image class="chevron" src="/assets/icons/chevron.png" /></view><view class="library-row" bindtap="openDrafts" hover-class="row-pressed" aria-role="button" aria-label="查看草稿箱"><view class="menu-icon"><image src="/assets/icons/edit.png" /></view><text class="grow">草稿箱</text><text wx:if="{{drafts.length}}" class="setting-value">{{drafts.length}}</text><image class="chevron" src="/assets/icons/chevron.png" /></view><view class="library-row" bindtap="tableSettings" hover-class="row-pressed" aria-role="button" aria-label="设置公司 Excel 表格格式"><view class="menu-icon"><image src="/assets/icons/edit.png" /></view><view class="grow"><view>表格设置</view><view class="menu-description">公司表头、字体与列</view></view><image class="chevron" src="/assets/icons/chevron.png" /></view><view class="library-row" bindtap="quickCurrency" hover-class="row-pressed" aria-role="button" aria-label="更改常用币种"><view class="menu-icon currency-symbol">¥</view><text class="grow">常用币种</text><text class="setting-value">{{saving ? '保存中' : profile.defaultCurrency}}</text><image class="chevron" src="/assets/icons/chevron.png" /></view><view class="library-row" bindtap="showHelp" hover-class="row-pressed" aria-role="button" aria-label="打开使用帮助"><view class="menu-icon"><image src="/assets/icons/document.png" /></view><text class="grow">使用帮助</text><image class="chevron" src="/assets/icons/chevron.png" /></view></view>
  <view class="settings-list"><view class="setting-row logout-row" bindtap="logout" hover-class="row-pressed" aria-role="button" aria-label="退出当前账号">退出登录</view></view><view wx:if="{{error}}" class="error">{{error}}</view>
</view>
