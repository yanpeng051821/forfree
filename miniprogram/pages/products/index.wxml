<view wx:if="{{authenticated}}" class="page products-page {{compact ? 'compact-records' : ''}} {{manageMode ? 'is-managing' : ''}} {{undoCount ? 'has-undo' : ''}}">
    <view class="page-settings-row"><button class="page-settings-button" bindtap="settings" disabled="{{mutationBusy}}" aria-label="打开设置" hover-class="control-pressed">设置</button></view>
    <view wx:if="{{drafts.length && !project && viewMode === 'task'}}" class="draft-preview-list"><view wx:for="{{drafts}}" wx:key="draftKey" class="draft-preview-row" data-index="{{index}}" bindtap="resumeDraft" hover-class="row-pressed"><view class="draft-preview-thumb"><image wx:if="{{item.photos[0].path}}" src="{{item.photos[0].path}}" mode="aspectFill" /><image wx:else class="placeholder-icon" src="/assets/icons/image.png" /></view><text class="grow">{{item.fields.name || '未命名商品'}}</text><text class="draft-pill">{{item.editId ? '未保存修改' : '未保存'}}</text><image class="icon sm" src="/assets/icons/chevron.png" /></view></view>
  <view wx:if="{{!project && viewMode === 'task' && !loading}}" class="empty"><view class="name">先选一家商户</view><view class="notice">选择商户后连续记录商品</view><view class="empty-actions"><button class="secondary" bindtap="tasks" hover-class="button-pressed" hover-stay-time="80">选择商户</button><button class="primary" bindtap="newBatch" hover-class="button-pressed" hover-stay-time="80">新增商户</button></view></view>
  <block wx:elif="{{project || viewMode !== 'task'}}">
    <view wx:if="{{viewMode === 'favorites'}}" class="workspace row between"><view><view class="workspace-name">收藏的商品</view><view class="workspace-meta">{{summary ? summary.total : '—'}} 件</view></view><view wx:if="{{!compareMode && !manageMode}}" class="product-export" bindtap="export" aria-role="button" aria-label="导出收藏商品" hover-class="control-pressed"><image class="icon" src="/assets/icons/export.png" /><text>导出</text></view></view>
    <view wx:else class="workspace row between"><view class="grow workspace-context" hover-class="press" bindtap="tasks" aria-role="button" aria-label="选择商户"><view class="workspace-name row"><text>{{supplier !== null ? (supplier || '未填写商户') : (viewMode === 'day' || merchantDay ? '所有商户' : project.name)}}</text><image class="icon sm" src="/assets/icons/chevron.png" /></view><view wx:if="{{project && project.market && supplier !== null}}" class="workspace-meta">{{project.market}}</view><view wx:if="{{viewMode === 'task' && !merchantDay}}" class="workspace-meta">{{project.date}}</view></view><view class="workspace-tools row"><view wx:if="{{viewMode === 'task' && !merchantDay}}" class="icon-button" bindtap="review" aria-role="button" aria-label="按日期查看商品" hover-class="press"><image class="icon" src="/assets/icons/calendar.png" /></view><view wx:if="{{!compareMode && !manageMode}}" class="product-export" bindtap="export" aria-role="button" aria-label="在导出页确认日期和商户范围" hover-class="control-pressed"><image class="icon" src="/assets/icons/export.png" /><text>{{query || (status !== 'all' && status !== 'confirmed') ? (status === 'confirmed' ? '导出已核对' : '导出全部') : '导出'}}</text></view></view></view>
    <view wx:if="{{viewMode === 'day' || merchantDay}}" class="record-date-modes"><view data-mode="day" bindtap="changeRange" class="{{dateMode !== 'range' ? 'active' : ''}}">单日</view><view data-mode="range" bindtap="changeRange" class="{{dateMode === 'range' ? 'active' : ''}}">日期范围</view><view class="grow" /><view bindtap="toggleCompact">{{compact ? '大图' : '紧凑'}}</view></view>
    <view wx:if="{{(viewMode === 'day' || merchantDay) && dateMode !== 'range'}}" class="workspace-dates"><date-rail selected-date="{{merchantDay ? viewDate : date}}" counts="{{dateCounts}}" max-date="{{today}}" bindchange="dateChange" /></view>
    <view wx:if="{{viewMode === 'day' && dateMode === 'range'}}" class="record-range"><picker mode="date" value="{{dateFrom}}" end="{{dateTo}}" disabled="{{mutationBusy}}" data-key="dateFrom" bindchange="rangeDate"><view>{{dateFrom}}</view></picker><text>至</text><picker mode="date" value="{{dateTo}}" start="{{dateFrom}}" end="{{today}}" disabled="{{mutationBusy}}" data-key="dateTo" bindchange="rangeDate"><view>{{dateTo}}</view></picker></view>
    <scroll-view wx:if="{{merchants.length}}" class="merchant-rail" scroll-x enhanced show-scrollbar="{{false}}"><view class="merchant-track"><view class="merchant-chip {{supplier === null ? 'chosen' : ''}}" bindtap="allMerchants" hover-class="control-pressed">所有商家</view><view wx:for="{{merchants}}" wx:key="supplier" class="merchant-chip {{supplier === item.supplier ? 'chosen' : ''}}" data-supplier="{{item.supplier}}" bindtap="merchant" hover-class="control-pressed"><text>{{item.supplier || '未填写商家'}}</text><text class="merchant-count">{{item.total}}</text></view><view wx:if="{{viewMode === 'task'}}" class="merchant-chip merchant-new" bindtap="newMerchant" hover-class="control-pressed">＋ 商家</view></view></scroll-view>
    <view class="search-box row"><image class="icon sm" src="/assets/icons/search.png" /><input value="{{query}}" bindinput="search" bindconfirm="reloadResults" disabled="{{mutationBusy}}" maxlength="200" confirm-type="search" placeholder="商品、货号、供应商" /><view wx:if="{{query}}" class="search-clear" bindtap="clearSearch" aria-label="清除搜索" hover-class="press" hover-stay-time="80">×</view></view>
    <scroll-view class="filters" scroll-x enhanced show-scrollbar="{{false}}"><view class="filter-track"><view class="filter {{status === 'all' ? 'active' : ''}}" data-value="all" bindtap="status" hover-class="press" hover-stay-time="80">全部 <text>{{summary ? summary.total : ''}}</text></view><view class="filter {{status === 'pending' ? 'active' : ''}}" data-value="pending" bindtap="status" hover-class="press" hover-stay-time="80">待核对 <text>{{summary ? summary.pending : ''}}</text></view><view class="filter {{status === 'confirmed' ? 'active' : ''}}" data-value="confirmed" bindtap="status" hover-class="press" hover-stay-time="80">已核对 <text>{{summary ? summary.confirmed : ''}}</text></view><view class="filter {{status === 'missingPrice' ? 'active' : ''}}" data-value="missingPrice" bindtap="status" hover-class="press" hover-stay-time="80">缺价格 <text>{{summary ? summary.missingPrice : ''}}</text></view></view></scroll-view>
    <view wx:if="{{drafts.length}}" class="draft-preview-list"><view wx:for="{{drafts}}" wx:key="draftKey" class="draft-preview-row" data-index="{{index}}" bindtap="resumeDraft" hover-class="row-pressed"><view class="draft-preview-thumb"><image wx:if="{{item.photos[0].path}}" src="{{item.photos[0].path}}" mode="aspectFill" /><image wx:else class="placeholder-icon" src="/assets/icons/image.png" /></view><text class="grow">{{item.fields.name || '未命名商品'}}</text><text class="draft-pill">{{item.editId ? '未保存修改' : '未保存'}}</text><image class="icon sm" src="/assets/icons/chevron.png" /></view></view>
    <view class="results-heading row between"><text class="muted">{{loading ? '正在查找' : matchedCount + ' 件商品'}}</text><view class="list-tools row"><view class="compare-mode" hover-class="control-pressed" hover-stay-time="80" bindtap="toggleCompareMode" aria-role="button" aria-label="{{compareMode ? '取消选择对比' : '选择两件商品对比'}}">{{compareMode ? '取消对比' : '对比'}}</view><view class="manage-entry {{manageMode ? 'active' : ''}}" hover-class="control-pressed" hover-stay-time="80" bindtap="toggleManageMode" aria-role="button" aria-label="{{manageMode ? '完成商品管理' : '批量管理商品'}}">{{manageMode ? '完成' : '管理'}}</view><view class="list-menu" bindtap="organizeMenu" hover-class="control-pressed" hover-stay-time="80" aria-role="button" aria-label="导出与回收站">···</view></view></view>
    <view wx:if="{{manageMode}}" class="manage-hint row between"><text>已选 {{manageIds.length}} / 50 · 长按也可管理单件</text><view bindtap="selectLoaded" hover-class="control-pressed" hover-stay-time="80" aria-role="button" aria-label="选择或取消当前已加载商品">选择已加载</view></view>
    <block wx:if="{{items.length}}"><view wx:for="{{merchantGroups}}" wx:key="supplier" wx:for-item="group" class="merchant-section"><view wx:if="{{supplier === null}}" class="merchant-heading row between"><view class="grow merchant-name" data-supplier="{{group.supplier}}" bindtap="merchant" hover-class="control-pressed">{{group.label}}</view><view class="row merchant-tools"><view wx:if="{{viewMode === 'task' && group.supplier && !manageMode && !compareMode}}" class="icon-button" data-supplier="{{group.supplier}}" bindtap="add" aria-label="在这家商户记录新品" hover-class="press"><image class="icon sm" src="/assets/icons/camera.png" /></view></view></view><view class="product-grid {{group.items.length === 1 ? 'single-product' : ''}}"><view wx:for="{{group.items}}" wx:key="id" id="product-{{item.id}}" class="product-tile {{item.manageSelected ? 'manage-selected' : ''}} {{item.actionBusy ? 'action-pending' : ''}}"><view class="product-visual" data-id="{{item.id}}" bindtap="edit" bindlongpress="productActions" hover-class="press" hover-stay-time="80"><image wx:if="{{item.cover}}" class="product-image" lazy-load="{{true}}" src="{{item.cover}}" mode="aspectFill" /><view wx:else class="product-image blank-image"><image class="placeholder-icon" src="/assets/icons/image.png" /></view><view wx:if="{{manageMode || compareMode || item.selected}}" class="select-control {{(manageMode ? item.manageSelected : item.selected) ? 'selected' : ''}}" data-id="{{item.id}}" catchtap="toggleSelection" aria-role="checkbox" aria-checked="{{manageMode ? item.manageSelected : item.selected}}" aria-label="{{manageMode ? '选择商品进行管理' : '选择商品进行对比'}}" hover-class="press" hover-stay-time="80"><view class="selection-circle"><text wx:if="{{manageMode ? item.manageSelected : item.selected}}">✓</text></view></view><view wx:if="{{!manageMode && !compareMode}}" class="favorite-control {{item.favoriteBusy ? 'is-pending' : ''}}" data-id="{{item.id}}" catchtap="toggleFavorite" hover-class="favorite-pressed" aria-busy="{{item.favoriteBusy}}" aria-role="button" aria-label="{{item.favorite ? '取消收藏' : '收藏商品'}}"><image src="/assets/icons/{{item.favorite ? 'heart-filled' : 'heart'}}.png" /><view wx:if="{{item.favoriteBusy}}" class="favorite-saving" /></view><view wx:if="{{item.actionBusy}}" class="product-action-state"><view class="action-spinner" /><text>{{mutationId === item.id ? mutationLabel + '中' : '请选择操作'}}</text></view><view wx:if="{{item.confirmed}}" class="visual-status {{item.confirmed ? 'verified' : 'pending'}}"><text wx:if="{{item.confirmed}}">✓</text><text wx:else class="dot orange" /></view><view wx:if="{{item.photos.length > 1}}" class="photo-count num">{{item.photos.length}}</view></view><view class="product-copy" hover-class="copy-pressed" data-id="{{item.id}}" bindtap="edit" bindlongpress="productActions" hover-stay-time="80"><view class="product-name">{{item.name}}</view><view wx:if="{{viewMode !== 'task'}}" class="source-task">{{item.recordDateText}}</view><view class="price-row"><text class="price num {{item.unitPrice === null ? 'unpriced' : ''}}">{{item.priceText}}</text></view><view wx:if="{{item.rating || item.evaluation}}" class="product-rating"><text wx:if="{{item.rating}}">★ {{item.rating}}</text><text wx:if="{{item.evaluation}}" class="rating-evaluation">{{item.evaluation}}</text></view><view wx:if="{{item.organizeLabel}}" class="organize-state">{{item.organizeLabel}}</view><view class="product-detail"><text wx:if="{{item.moq !== null}}">{{item.moq}} 件起订</text><text wx:if="{{item.sku}}" class="sku">{{item.sku}}</text></view></view></view></view>
</view></block>
    <view wx:if="{{!items.length && !loading}}" class="empty"><view class="name">{{summary && summary.total ? '没有匹配的商品' : (viewMode === 'day' ? (dateMode === 'range' ? '这个日期范围没有保存记录' : '这一天没有保存记录') : viewMode === 'favorites' ? '暂无收藏' : '暂无商品')}}</view><view class="notice">{{summary && summary.total ? '试试其他关键词或筛选条件' : (viewMode === 'day' ? '换个日期或日期范围看看' : viewMode === 'favorites' ? '去商品列表点爱心收藏' : supplier ? '点击下方相机开始记录' : '先选择商户再记录商品')}}</view></view><view wx:if="{{hasMore || loadingMore}}" class="load-more" bindtap="loadMore" hover-class="press" hover-stay-time="80">{{loadingMore ? '加载中…' : '加载更多'}}</view>
    <view class="sourcing-dock"><view wx:if="{{undoCount}}" class="undo-strip row"><text class="grow">{{undoMessage}} · {{undoCount}} 件</text><button class="small secondary" bindtap="undoMove" disabled="{{mutationBusy}}" hover-class="button-pressed" hover-stay-time="80">撤销</button><view class="undo-trash" bindtap="openTrash" hover-class="control-pressed" hover-stay-time="80">回收站</view></view><view wx:if="{{mutationBusy}}" class="mutation-progress" aria-live="polite">{{mutationLabel}}中 · {{mutationDone}} / {{mutationTotal}}</view><view wx:if="{{manageMode}}" class="manage-strip"><text class="selection-count">已选 {{manageIds.length}} 件</text><view class="manage-actions row"><button class="primary small" bindtap="moveSelected" disabled="{{!manageIds.length || mutationBusy || loading || loadingMore}}" loading="{{mutationBusy && mutationLabel === '移入回收站'}}" hover-class="button-pressed" hover-stay-time="80">移入回收站</button><button class="danger small" bindtap="deleteSelected" disabled="{{!manageIds.length || mutationBusy || loading || loadingMore}}" hover-class="button-pressed" hover-stay-time="80">永久删除</button></view></view><view wx:if="{{!manageMode && selectedIds.length}}" class="compare-strip row"><view class="icon-button" bindtap="clearCompare" aria-label="取消对比" hover-class="press" hover-stay-time="80"><text class="close-icon">×</text></view><text class="grow selection-count">{{selectedIds.length === 1 ? '再选一件就能对比' : '已选 2 件'}}</text><button class="primary small" disabled="{{selectedIds.length !== 2}}" bindtap="compare" hover-class="button-pressed" hover-stay-time="80">对比</button></view><view wx:if="{{(viewMode === 'task' || viewMode === 'day') && !manageMode && !compareMode}}" class="capture-strip"><button wx:if="{{supplier}}" class="capture-button" bindtap="add" aria-label="在当前商户记录商品" hover-class="button-pressed" hover-stay-time="80"><image class="icon lg" src="/assets/icons/camera-white.png" /></button><button wx:else class="primary" bindtap="tasks" hover-class="button-pressed" hover-stay-time="80">选择商户</button></view></view>
  </block><view wx:if="{{loading}}" class="loading-line">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="load" hover-class="press" hover-stay-time="80">重试</view></view>
</view>
