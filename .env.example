# Server only. Never put these credentials in miniprogram/ or source control.
WECHAT_APP_ID=wx676d460774c18c95
WECHAT_APP_SECRET=
# openai: direct provider; workbuddy: reuse the existing cloud LLM gateway.
MODEL_PROVIDER=workbuddy
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
# Optional in workbuddy mode: leave empty to select from the gateway model catalog.
MODEL_NAME=
# WorkBuddy mode uses the existing cloud app already authorized for the Huoji AppID.
# The publishable key is an app identifier, NOT a provider API secret.
WB_CLOUD_ENDPOINT=
WB_CLOUD_PUBLISHABLE_KEY=
# 32-byte random encryption key as 64 hex characters. Server only; retain across restarts.
WB_SESSION_ENCRYPTION_KEY=
HOST=127.0.0.1
PORT=3000
# Explicit local-only fallback. Must be false for production or public bindings.
ALLOW_DEV_LOGIN=false
# APP_DATA_DIR=/absolute/path/to/persistent-data
# Production public/container binding requires the exact number of trusted proxies (0, 1 or 2).
# NODE_ENV=production
# HOST=0.0.0.0
# TRUSTED_PROXY_HOPS=1
