.compare-page{padding-top:28rpx;padding-bottom:190rpx;color:#202226;background:#fafafa}.compare-page .primary{background:#202226;color:#fff}.compare-page .muted{color:#686d72}.compare-page .error{background:#f0f1f2;color:#202226}.compare-page .quiet{background:transparent;color:#686d72}.compare-intro{margin-bottom:26rpx}.compare-title{font-size:36rpx;font-weight:600;margin-bottom:8rpx}.comparison-head{display:flex;gap:22rpx;align-items:stretch}.compare-product{flex:1;min-width:0;background:#fff;border:1rpx solid #e5e7e8;border-radius:18rpx;padding:16rpx;display:flex;flex-direction:column;align-items:flex-start}.compare-image{display:block;width:100%;height:192rpx;border-radius:12rpx;background:#fafafa;margin-bottom:16rpx}.blank-image{display:flex;align-items:center;justify-content:center}.blank-image .icon{opacity:.4;width:44rpx;height:44rpx}.compare-name{font-size:26rpx;font-weight:500;line-height:1.5;word-break:break-word}.compare-supplier{font-size:22rpx;color:#686d72;margin-top:6rpx;word-break:break-word;margin-bottom:18rpx}.compare-currency{font-size:21rpx;color:#686d72;margin-top:auto}.compare-price{font-size:34rpx;font-weight:600;letter-spacing:-.5rpx;margin:4rpx 0 10rpx;word-break:break-word}.compare-status{display:flex;align-items:center;font-size:21rpx;color:#686d72;gap:8rpx}.status-dot{display:inline-block;width:9rpx;height:9rpx;background:#686d72;border-radius:50%;flex-shrink:0}.status-dot.confirmed{background:#28805a}.compare-hint{color:#686d72;font-size:22rpx;padding:20rpx 0 26rpx;line-height:1.6}.compare-tabs{display:flex;border-bottom:1rpx solid #e5e7e8;gap:8rpx}.compare-tab{flex:1;min-width:0;height:80rpx;padding:0 10rpx;border-radius:0;border-bottom:4rpx solid transparent;background:transparent;color:#686d72;font-size:25rpx}.compare-tab.selected{color:#28805a;border-bottom-color:#28805a;font-weight:600}.difference-filter{padding:14rpx 0;font-size:22rpx;color:#686d72;min-height:90rpx}.difference-switch{gap:12rpx}.column-labels{display:flex;gap:22rpx;position:sticky;top:0;z-index:2;background:#fafafa;border-top:1rpx solid #e5e7e8;border-bottom:1rpx solid #e5e7e8;padding:16rpx 0}.column-labels>text{flex:1;min-width:0;font-size:22rpx;color:#686d72;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.column-labels>text:first-child{padding-right:20rpx;border-right:1rpx solid #e5e7e8}.comparison-row{padding:22rpx 0;border-bottom:1rpx solid #e5e7e8}.compare-label{font-size:22rpx;color:#686d72;margin-bottom:12rpx}.compare-values{display:flex;gap:22rpx}.compare-value{flex:1;min-width:0;font-size:25rpx;color:#202226;line-height:1.7;white-space:pre-wrap;word-break:break-word}.compare-value:first-child{padding-right:20rpx;border-right:1rpx solid #e5e7e8}.compare-value.missing{color:#686d72}.difference-label{font-size:20rpx;color:#28805a;border-radius:6rpx;background:#edf5f0;padding:2rpx 9rpx;flex-shrink:0}.comparison-empty{padding:50rpx 16rpx;color:#686d72;font-size:24rpx;text-align:center}.compare-page .toolbar{background:#fafafa;border-color:#e5e7e8}@media(max-width:360px){.comparison-head,.compare-values,.column-labels{gap:16rpx}.compare-product{padding:12rpx}.compare-image{height:164rpx}.compare-price{font-size:30rpx}.compare-name{font-size:24rpx}.compare-value:first-child,.column-labels>text:first-child{padding-right:16rpx}.compare-tab{font-size:24rpx}}

