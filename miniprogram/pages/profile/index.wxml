<view wx:if="{{authenticated}}" class="page profile-page"><form bindsubmit="saveProfile">
  <view class="profile-avatar-area"><button class="avatar-picker" style="width:152rpx;min-width:152rpx;max-width:152rpx;height:152rpx;flex:0 0 152rpx;" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{saving || avatarBusy}}" hover-class="press" aria-label="选择个人头像"><image wx:if="{{avatarPreview}}" class="avatar-image" src="{{avatarPreview}}" mode="aspectFill" /><text wx:else class="avatar-letter">{{avatarInitial}}</text><view class="avatar-camera"><image src="/assets/icons/camera-white.png" /></view><view wx:if="{{avatarBusy}}" class="avatar-loading">处理中</view></button><view class="avatar-hint">点击更换头像</view><button wx:if="{{avatarPreview}}" class="avatar-remove" bindtap="removeAvatar" disabled="{{saving || avatarBusy}}" hover-class="press">移除头像</button></view>
  <view class="profile-group"><view class="profile-field"><text>姓名</text><input name="name" type="nickname" value="{{form.name}}" disabled="{{saving}}" maxlength="80" data-key="name" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" confirm-type="next" placeholder="怎么称呼你" aria-label="姓名" /></view><view class="profile-field"><text>公司 / 商号</text><input value="{{form.company}}" disabled="{{saving}}" maxlength="200" name="company" data-key="company" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" confirm-type="next" placeholder="选填" aria-label="公司或商号" /></view><view class="profile-field"><text>身份</text><picker range="{{roles}}" value="{{roleIndex}}" disabled="{{saving}}" bindchange="role"><view class="profile-picker"><text>{{roles[roleIndex]}}</text><image src="/assets/icons/chevron.png" /></view></picker></view></view>
  <view class="profile-group"><view class="profile-field"><text>联系电话</text><input type="number" value="{{form.phone}}" disabled="{{saving}}" maxlength="80" name="phone" data-key="phone" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" confirm-type="next" placeholder="选填" aria-label="联系电话" /></view><view class="profile-field"><text>微信号</text><input value="{{form.wechat}}" disabled="{{saving}}" maxlength="120" name="wechat" data-key="wechat" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="blur" confirm-type="done" placeholder="选填" aria-label="微信号" /></view></view>
  <view class="profile-group"><view class="profile-field"><text>常用币种</text><picker range="{{currencies}}" value="{{currencyIndex}}" disabled="{{saving}}" bindchange="currency"><view class="profile-picker"><text>{{currencies[currencyIndex]}}</text><image src="/assets/icons/chevron.png" /></view></picker></view></view><view class="profile-help">用于新记录，已有商品保持原币种。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="toolbar profile-save" style="bottom:{{keyboardHeight}}px"><button class="primary" form-type="submit" loading="{{saving}}" disabled="{{saving || avatarBusy}}" hover-class="press">保存资料</button></view>
</form>
</view>
