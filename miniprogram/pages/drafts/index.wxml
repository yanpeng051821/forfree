<view wx:if="{{authenticated}}" class="page drafts-page"><view class="draft-list"><view wx:for="{{drafts}}" wx:key="draftKey" class="draft-row" data-index="{{index}}" bindtap="resume" hover-class="row-pressed" aria-role="button" aria-label="继续{{item.fields.name || '未命名商品'}}"><view class="draft-thumb"><image wx:if="{{item.photos[0].path}}" src="{{item.photos[0].path}}" mode="aspectFill" /><image wx:else class="placeholder" src="/assets/icons/image.png" /></view><view class="grow"><view class="draft-name">{{item.fields.name || '未命名商品'}}</view><view class="draft-meta">{{item.editId ? '未保存修改' : '未保存商品'}}</view></view><image class="chevron" src="/assets/icons/chevron.png" /></view></view><view wx:if="{{!drafts.length}}" class="empty">草稿箱为空</view></view>