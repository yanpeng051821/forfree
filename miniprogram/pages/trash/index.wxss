@import "../products/index.wxss";

page{background:#f5f7f5}.trash-page{padding:28rpx 28rpx calc(130rpx + env(safe-area-inset-bottom))}.trash-heading{margin-bottom:20rpx}.trash-heading .name{color:#253b2e;font-size:34rpx}.trash-heading .notice{margin:8rpx 0 0;color:#718579;font-size:22rpx}.trash-count{font-size:22rpx;color:#718579;margin:0 2rpx 20rpx}.trash-card{background:#fff;border-radius:22rpx;margin-bottom:20rpx;overflow:hidden}.trash-card.manage-selected{box-shadow:0 0 0 3rpx #28805a}.trash-record{padding:20rpx;gap:20rpx}.trash-thumb{width:126rpx;height:144rpx;border-radius:14rpx;background:#e8eeea;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0}.trash-thumb image{width:100%;height:100%}.trash-thumb .placeholder-icon{width:40rpx;height:40rpx;opacity:.3}.trash-source,.trash-meta{font-size:21rpx;color:#718579;margin-top:8rpx}.trash-actions{padding:0 20rpx 20rpx;justify-content:flex-end;gap:16rpx}.trash-actions .primary{background:#263b32}.trash-delete{background:#fff;color:#9b6e64;font-size:23rpx}.trash-pending{font-size:22rpx;color:#61776a;padding:0 20rpx 16rpx}.trash-check{display:flex;align-items:center;justify-content:center;width:64rpx;height:76rpx;flex-shrink:0}.trash-check .selection-circle{border-color:#bbcabe;background:#fff;color:#fff}.trash-check.selected .selection-circle{border-color:#263b32;background:#263b32}.trash-dock{position:fixed;bottom:0;left:0;right:0;z-index:10;background:#f5f7f5;padding-bottom:env(safe-area-inset-bottom)}.trash-page.is-managing{padding-bottom:calc(230rpx + env(safe-area-inset-bottom))}.trash-card.action-pending{background:#eef4ef}

.trash-actions{padding:0 14rpx 12rpx;gap:8rpx}.trash-actions .trash-icon{width:72rpx;height:64rpx;min-width:72rpx;flex:0 0 72rpx;min-height:64rpx;padding:0;margin:0;background:transparent;border-radius:14rpx;display:flex;align-items:center;justify-content:center;box-shadow:none}.trash-icon image{width:32rpx;height:32rpx}.trash-icon-pressed{background:#edf2ee!important;transform:scale(.92)}.trash-icon[disabled]{opacity:.35}.trash-source{line-height:1.5}
