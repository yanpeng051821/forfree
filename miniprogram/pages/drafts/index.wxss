.drafts-page{background:#f5f7f5;padding:24rpx 28rpx}.draft-list{background:white;border-radius:24rpx;overflow:hidden}.draft-row{display:flex;align-items:center;gap:22rpx;padding:24rpx;border-bottom:1rpx solid #edf1ee}.draft-row:last-child{border:0}.draft-thumb{width:100rpx;height:112rpx;flex:0 0 100rpx;background:#eef2ef;border-radius:18rpx;overflow:hidden;display:flex;align-items:center;justify-content:center}.draft-thumb image{width:100%;height:100%}.draft-thumb .placeholder{width:34rpx;height:34rpx;opacity:.4}.draft-name{font-size:28rpx;color:#263b32}.draft-meta{font-size:22rpx;color:#8b988f;margin-top:10rpx}.chevron{width:22rpx;height:22rpx;opacity:.4}