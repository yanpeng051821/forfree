page{background:#fafafa}.login-page{min-height:100vh;padding:64rpx 56rpx calc(64rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column}.login-intro{flex:1;display:flex;flex-direction:column;justify-content:center;padding-bottom:100rpx}.login-title{font-size:56rpx;font-weight:500;letter-spacing:2rpx;line-height:1.35}.login-caption{font-size:26rpx;color:#92969c;margin-top:24rpx}.login-actions{width:100%;max-width:640rpx;align-self:center}.login-button{width:100%;height:96rpx;border-radius:20rpx;font-size:29rpx}.login-error{font-size:25rpx;color:#a7743e;line-height:1.65;margin-bottom:28rpx;word-break:break-word}.dev-button{width:100%;margin-top:20rpx;font-size:25rpx}
.login-actions>button{width:100%;max-width:none}

.login-caption{color:#68737f}.login-title{font-size:62rpx;font-weight:600;letter-spacing:0}.login-intro{padding-bottom:140rpx}.login-button{height:96rpx;border-radius:18rpx}
