    "status": "四批本地实现与回归完成；桌面/真实容器/微信真机待验；不含部署授权",
    "scope": "采购员自己记录、整理、比较各商家的商品数据，输出参考样式Excel",
    "excluded": [
      "采购单tab",
      "批次实体",
      "下单流程",
      "计入/取消/后补状态",
      "发送状态",
      "商户确认",
      "客户CRM",
      "客户报价/回选",
      "付款对账",
      "收货核对",
      "团队共享",
      "柜容预算",
      "独立Web工作台"
    ],
    "viewport": {
      "widths": [
        320,
        375,
        414
      ],
      "height": 812,
      "rpxPerPxAt375": 2
    },
    "drawingNotes": [
      "样例商品、店名、价格全部虚构；不展示任何联系方式数字",
      "保留系统相机，不画页内取景器或录音功能",
      "示意图不是运行中的小程序，按钮仅作导航或布局示意",
      "八张图是现有页面/弹层/范围的状态，不新增八条路由；补充资料复用编辑页",
      "商户/商品两个tab；右上角进入普通设置页；辅助页面不画tabBar"
    ],
    "changes": [
      "最终商户/商品两tab、右上角设置；四批本地实现；不建立下单/批次/客户/团队业务",
      "使用实际ProductFields，不以概念伪字段作为数据库字段",
      "取消独立整理队列及逐字段AI来源系统，复用编辑页人工补充",
      "首期导出日期/商户/all或confirmed，不实现q/status/ids导出",
      "参考带图商品表十一列；派生公式+缓存已实现，实际合成xlsx验证",
      "容器v2二进制640KiB分段；保护缓存60MiB/导出7天，需真机验收"
    ],
    "authority": "SOLUTION.md",
    "deferred": [
      "独立整理队列",
      "逐字段AI来源模型",
      "搜索结果/所选导出",
      "独立商户档案",
      "自动合并",
      "照片裁剪旋转",
      "多件离线上传队列"
    ]
  },
  "principles": [
    "记录一次，复看补充，直接导出；减少手机到Excel的重复录入",
    "明确当前商户，连续录入不串店；缺少商户时先选店",
    "未知留空，不让AI根据外观猜价格、数量、体积",
    "资料检查不是采购决定；收藏是个人偏好，不代表要买",
    "保留记录日期和历史版本，不自动合并同货号记录",
    "参考Excel只指导字段与版式，不指导扩张业务流程",
    "复用现有个人数据、商户入口和公司模板，不为小功能建完整系统"
  ],
