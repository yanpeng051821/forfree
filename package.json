{
  "name": "huoji-market-notes",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx --watch src/server/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env.local dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && node --test tests/*.test.cjs",
    "test:api": "node tests/api-smoke.mjs",
    "check:release": "node scripts/check-miniprogram-release.cjs",
    "pack:backend": "node scripts/package-backend.cjs",
    "seed:demo": "node --env-file-if-exists=.env.local --import tsx scripts/seed-demo.ts",
    "inspect:procurement": "node --import tsx scripts/inspect-procurement.ts",
    "maintenance": "node --env-file-if-exists=.env.local --import tsx src/server/maintenance.ts"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "3.18.3",
    "@fastify/multipart": "9.2.1",
    "@fastify/rate-limit": "10.3.0",
    "exceljs": "4.4.0",
    "fastify": "5.12.7",
    "jszip": "3.10.2",
    "saxes": "5.0.1",
    "sharp": "0.35.5",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
