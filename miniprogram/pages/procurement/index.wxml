<view wx:if="{{authenticated}}" class="page procurement-page">
  <view wx:if="{{loading}}" class="loading-line">加载中…</view>
  <block wx:if="{{!doc}}">
    <view class="purchase-intro"><view class="page-title">采购单</view><text class="muted">整理现场选品，确认数量与报价</text></view>
    <view class="task-source"><text class="source-label">来源 · 当前看货任务</text><block wx:if="{{sourceTask}}"><text class="source-task-name">{{sourceTask.name}}</text><text class="muted">{{sourceTask.count === null ? '商品数量待读取' : sourceTask.count + ' 件商品'}}</text></block><text wx:else class="muted">{{sourceNotice || '读取当前任务…'}}</text></view>
    <view class="create-action"><button wx:if="{{!sourceUnsupported}}" class="primary" bindtap="fromTask" loading="{{loading}}" disabled="{{busy || loading}}" hover-class="button-pressed" hover-stay-time="80">从当前看货生成采购单</button><block wx:else><view class="currency-notice">当前采购单仅支持人民币商品。该任务可继续导出含原币种的选品报价表。</view><button class="primary" bindtap="exportSource" disabled="{{busy || loading || !sourceTask}}" hover-class="button-pressed" hover-stay-time="80">导出当前任务报价表</button></block></view>
    <view class="record-heading row between"><text>已有采购单</text><text class="muted">{{records.length}} 份</text></view>
    <view wx:for="{{records}}" wx:key="id" class="record-row row" data-id="{{item.id}}" bindtap="open" hover-class="press" aria-role="button" aria-label="打开采购单{{item.name}}"><view class="grow"><view class="record-name">{{item.name}}</view><view class="muted">{{item.summary.lines}} 件 · {{item.summary.suppliers}} 家供应商<text wx:if="{{item.summary.pending}}"> · {{item.summary.pending}} 待核对</text></view></view><image class="icon sm" src="/assets/icons/chevron.png" /></view>
    <view wx:if="{{!records.length && !loading}}" class="empty"><view class="name">暂无采购单</view><text class="muted">完成现场记录后，在这里生成</text></view>
  </block>
  <block wx:else>
    <view class="doc-header row between"><view class="grow"><view class="doc-name">{{doc.name}}</view><view class="muted">{{doc.summary.lines}} 件商品 · {{doc.summary.suppliers}} 家供应商</view></view><button class="quiet small" bindtap="backList" disabled="{{busy || loading}}" aria-label="返回采购单列表" hover-class="button-pressed" hover-stay-time="80">单据列表</button></view>
    <view wx:if="{{retainedCount}}" class="retained-notice">{{retainedCount}} 项未保存调整已保留，点原商品或运费继续</view>
    <view class="summary"><view class="summary-label">已计入合计 · {{doc.summary.currencyText}}</view><view class="summary-number num">{{doc.summary.amountText}}</view><view class="summary-status"><text>{{doc.summary.included}} 已计入</text><text wx:if="{{doc.summary.pending}}">{{doc.summary.pending}} 待核对</text><text wx:if="{{doc.summary.cancelled}}">{{doc.summary.cancelled}} 已取消</text></view></view>
    <view class="search-row row"><image class="icon sm" src="/assets/icons/search.png" /><input value="{{query}}" bindinput="search" placeholder="搜索货号、供应商" aria-label="搜索采购商品" /></view>
    <view class="filters row"><picker class="grow" range="{{supplierNames}}" value="{{supplierIndex}}" bindchange="supplier" aria-label="按供应商筛选"><view class="filter-pill row between"><text>{{supplierNames[supplierIndex]}}</text><text class="filter-arrow">⌄</text></view></picker><picker class="grow" range="{{filters}}" value="{{filterIndex}}" bindchange="status" aria-label="按处理决定筛选"><view class="filter-pill row between"><text>{{filters[filterIndex]}}</text><text class="filter-arrow">⌄</text></view></picker></view>
    <view wx:for="{{lines}}" wx:key="id" class="purchase-row">
      <view class="row product-main"><view class="purchase-thumb" data-id="{{item.id}}" bindtap="preview" aria-role="button" aria-label="查看{{item.sku}}照片" hover-class="press" hover-stay-time="80"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFit" /><image wx:else class="icon" src="/assets/icons/image.png" /><text wx:if="{{item.imageCount > 1}}" class="photo-count">{{item.imageCount}}</text></view><view class="grow product-copy" data-id="{{item.id}}" bindtap="edit" aria-role="button" aria-label="调整{{item.sku}}数量与报价" hover-class="press" hover-stay-time="80"><view class="sku">{{item.sku}}</view><view class="purchase-supplier">{{item.supplier}}</view><view class="purchase-quantity num">{{item.quantityText}} 件 · {{item.currency}} {{item.priceText}} / 件</view><view class="row between amount-row"><text class="purchase-amount num">{{item.currency}} {{item.amountText}}</text><text class="decision {{item.decision}}">{{item.decisionText}}</text></view></view><button class="edit-button" data-id="{{item.id}}" bindtap="edit" disabled="{{busy}}" aria-label="核对商品{{item.sku}}" hover-class="button-pressed" hover-stay-time="80"><image class="icon sm" src="/assets/icons/edit.png" /></button></view>
      <view wx:if="{{item.warning}}" class="purchase-warning">{{item.warning}}</view>
      <button wx:if="{{item.description || item.note}}" class="line-disclosure" data-id="{{item.id}}" bindtap="toggleLine" aria-label="{{expandedLine === item.id ? '收起' : '展开'}}{{item.sku}}说明与备注" hover-class="button-pressed" hover-stay-time="80"><text>说明与备注</text><text>{{expandedLine === item.id ? '收起' : '查看'}}</text></button>
      <view wx:if="{{expandedLine === item.id}}" class="line-details"><view wx:if="{{item.description}}" class="purchase-description">{{item.description}}</view><view wx:if="{{item.note}}" class="purchase-description"><text class="detail-label">备注 </text>{{item.note}}</view></view>
    </view>
    <button wx:if="{{matched > lines.length}}" class="more" bindtap="more" hover-class="button-pressed" hover-stay-time="80">继续查看 · {{matched - lines.length}} 件</button><view wx:if="{{!lines.length}}" class="empty"><view class="name">没有匹配商品</view></view>
    <view class="supplier-section"><button class="section-disclosure" bindtap="toggleSuppliers" aria-label="{{suppliersOpen ? '收起供应商与包装要求' : '展开供应商与包装要求'}}" hover-class="button-pressed" hover-stay-time="80"><view class="grow"><text class="disclosure-title">运费与供应商</text><text class="disclosure-summary">{{doc.suppliers.length}} 家<text wx:if="{{supplierPending}}"> · {{supplierPending}} 家运费待填</text></text></view><text class="disclosure-action">{{suppliersOpen ? '收起' : '查看'}}</text></button><block wx:if="{{suppliersOpen}}"><view wx:for="{{doc.suppliers}}" wx:key="name" class="supplier-row"><view class="row between"><text class="supplier-name">{{item.name}}</text><button class="quiet small freight-button" data-name="{{item.name}}" bindtap="editFreight" disabled="{{busy}}" aria-label="编辑{{item.name}}运费" hover-class="button-pressed" hover-stay-time="80">运费 {{item.freight === null ? '待填' : item.freight}}</button></view><text wx:if="{{item.information}}" class="supplier-information">{{item.information}}</text><view wx:for="{{item.warnings}}" wx:for-item="warning" wx:key="*this" class="purchase-warning">{{warning}}</view></view></block></view>
    <view class="document-options"><button class="section-disclosure" bindtap="toggleOptions" aria-label="{{optionsOpen ? '收起单据选项' : '展开单据选项'}}" hover-class="button-pressed" hover-stay-time="80"><text class="disclosure-title">单据选项</text><text class="disclosure-action">{{optionsOpen ? '收起' : '查看'}}</text></button><block wx:if="{{optionsOpen}}"><button class="option-link" bindtap="applyTemplate" disabled="{{busy}}" hover-class="button-pressed" hover-stay-time="80">应用最新表格设置</button><block wx:if="{{doc.sourceHash}}"><view class="source-summary"><text>原表合计 · CNY</text><text class="num">{{doc.summary.sourceAmountText}}</text></view><button class="option-link" bindtap="sourceSelection" disabled="{{busy}}" hover-class="button-pressed" hover-stay-time="80">按原表计入</button><button class="option-link" data-original="yes" bindtap="exportFile" disabled="{{busy}}" hover-class="button-pressed" hover-stay-time="80">查看原 Excel</button></block><button class="option-link remove-link" bindtap="remove" disabled="{{busy}}" hover-class="button-pressed" hover-stay-time="80">删除采购单</button></block></view>
    <view wx:if="{{!editing && !freightEditing}}" class="toolbar"><text class="export-caption">打开 Excel 后，可通过菜单分享</text><button class="primary" bindtap="exportFile" disabled="{{busy || loading}}" loading="{{busy}}" hover-class="button-pressed" hover-stay-time="80">导出 Excel</button></view>
  </block>
  <view wx:if="{{error && !editing && !freightEditing}}" class="error">{{error}}<button class="quiet small" bindtap="retry" disabled="{{busy || loading}}" hover-class="button-pressed" hover-stay-time="80">重试</button></view>
  <view wx:if="{{editing || freightEditing}}" class="edit-overlay"><view class="edit-sheet" aria-role="dialog" aria-label="{{editing ? '调整采购商品' : '编辑供应商运费'}}">
    <view class="row between sheet-heading"><view class="section-title">{{editing ? editing.sku : freightEditing.name}}</view><button class="close-button" bindtap="cancelEdit" disabled="{{busy}}" aria-label="关闭核对" hover-class="button-pressed" hover-stay-time="80"><text class="close-icon">×</text></button></view>
    <view wx:if="{{editNeedsReview}}"><button class="secondary review-action" bindtap="reviewCurrent" disabled="{{busy}}" hover-class="button-pressed" hover-stay-time="80">核对当前采购内容</button></view>
    <view wx:if="{{editReview}}" class="conflict-review">
      <view class="section-title">本机 / 服务器 · 版本 {{editReview.version}}</view>
      <view wx:for="{{editReview.rows}}" wx:key="key" class="conflict-row"><text class="conflict-name">{{item.name}}{{item.changed ? ' · 不同' : ''}}</text><text>本机：{{item.local}}</text><text>服务器：{{item.latest}}</text></view>
      <view wx:if="{{editReview.blocked}}" class="retained-notice">{{editReview.blocked}}</view>
      <button class="secondary review-action" bindtap="acceptCurrent" disabled="{{busy || editReview.blocked}}" hover-class="button-pressed" hover-stay-time="80">已逐项核对，保留本机并采用当前版本</button>
    </view>
    <block wx:if="{{editing}}">
      <view class="sheet-supplier">{{editing.supplier}}</view><view wx:if="{{editNotice}}" class="retained-notice">{{editNotice}}</view>
      <view class="field"><text class="label">处理决定</text><picker range="{{decisions}}" value="{{decisionIndex}}" bindchange="decision" disabled="{{busy}}" aria-label="处理决定"><view class="picker">{{decisions[decisionIndex]}}<text>⌄</text></view></picker></view>
      <view class="grid2"><view class="field"><text class="label">采购箱数</text><input type="number" data-key="cartons" value="{{form.cartons}}" bindinput="input" disabled="{{busy}}" placeholder="未知留空" aria-label="采购箱数" /></view><view class="field"><text class="label">每箱数量</text><input type="number" data-key="pcsPerCarton" value="{{form.pcsPerCarton}}" bindinput="input" disabled="{{busy}}" placeholder="未知留空" aria-label="每箱数量" /></view></view>
      <view wx:if="{{quantityEditable}}" class="field"><text class="label">实际采购数量 · 件</text><input type="number" data-key="quantity" value="{{form.quantity}}" bindinput="input" disabled="{{busy}}" placeholder="选填，清空后按箱数 × 每箱数量计算" aria-label="实际采购数量，留空按箱数乘每箱数量计算" /><view class="source-note">填写值优先，修改箱数不会改动；清空后按箱数 × 每箱数量计算</view></view>
      <view class="field"><text class="label">采购单价 · {{editing.currency}}</text><input type="digit" data-key="unitPrice" value="{{form.unitPrice}}" bindinput="input" disabled="{{busy}}" placeholder="未知留空" aria-label="采购单价，{{editing.currency}}" /></view>
      <view class="edit-calculation"><view><text class="label">采购数量</text><text class="num">{{quantityPreview}} 件</text></view><view><text class="label">商品金额 · {{editing.currency}}</text><text class="num">{{amountPreview}}</text></view></view>
      <button class="section-disclosure sheet-disclosure" bindtap="toggleLineDetails" aria-label="{{lineDetailsOpen ? '收起体积备注与扩展字段' : '展开体积备注与扩展字段'}}" hover-class="button-pressed" hover-stay-time="80"><text>体积、备注与扩展</text><text class="disclosure-action">{{lineDetailsOpen ? '收起' : '编辑'}}</text></button>
      <block wx:if="{{lineDetailsOpen}}"><view class="field"><text class="label">单箱体积 · m³</text><input type="digit" data-key="cartonCbm" value="{{form.cartonCbm}}" bindinput="input" disabled="{{busy}}" placeholder="未知留空" aria-label="单箱体积，立方米" /></view><view class="field"><text class="label">核对备注</text><textarea auto-height data-key="note" value="{{form.note}}" bindinput="input" disabled="{{busy}}" maxlength="2000" placeholder="供应商确认或调整原因" aria-label="核对备注" /></view><view wx:for="{{customInputs}}" wx:key="key" class="field"><text class="label">{{item.label}}</text><input value="{{item.value}}" data-key="{{item.key}}" bindinput="customInput" disabled="{{busy}}" maxlength="2000" placeholder="选填" aria-label="{{item.label}}" /></view><view class="source-note">来源：{{editing.source}}</view><view wx:if="{{editing.sourceMark}}" class="purchase-warning">原表标记：{{editing.sourceMark}}</view></block>
      <view wx:if="{{error}}" class="error">{{error}}</view><view class="sheet-footer"><button class="primary" bindtap="saveLine" loading="{{busy}}" disabled="{{busy || editNeedsReview}}" hover-class="button-pressed" hover-stay-time="80">保存调整</button></view>
    </block>
    <block wx:else><view wx:if="{{editNotice}}" class="retained-notice">{{editNotice}}</view><view class="field"><text class="label">供应商运费 · 人民币</text><input type="digit" value="{{freight}}" bindinput="freightInput" placeholder="确认无运费填 0" disabled="{{busy}}" aria-label="供应商运费，人民币" /></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="sheet-footer"><button class="primary" bindtap="saveFreight" loading="{{busy}}" disabled="{{busy || editNeedsReview}}" hover-class="button-pressed" hover-stay-time="80">保存运费</button></view></block>
  </view></view>
</view>
