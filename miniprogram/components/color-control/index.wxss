:host{display:block}.color-control{padding:20rpx 0 24rpx}.color-label{font-size:25rpx;color:#59635d;margin-bottom:22rpx}.color-options{display:flex;justify-content:space-between;gap:12rpx;padding:0 4rpx}.color-swatch{flex:0 0 48rpx;width:48rpx;height:48rpx;min-width:0;padding:0;margin:0;border-radius:50%;color:#fff;font-size:24rpx;line-height:48rpx;display:flex;justify-content:center;align-items:center;position:relative}.color-swatch::after{border:0}.color-swatch.selected{outline:3rpx solid #b8c9bd;outline-offset:6rpx}.swatch-pressed{transform:scale(.88)}button[disabled]{opacity:.4}
