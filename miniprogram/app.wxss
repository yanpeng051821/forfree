/* 货记：内容优先。页面只保留操作与真实数据。 */
page{background:#fafafa;color:#202226;font-size:28rpx;line-height:1.5;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}
view,text,button,input,textarea{box-sizing:border-box}
button{display:flex;align-items:center;justify-content:center;gap:12rpx;height:88rpx;margin:0;padding:0 24rpx;font-size:28rpx;font-weight:500;line-height:1.4;border-radius:20rpx}
button::after{border:0}button.primary{background:#202226;color:#fff}button.secondary{background:#f0f1f2;color:#34373b}button.danger{background:#fff2f0;color:#bc4942}button.small{height:64rpx;font-size:24rpx;border-radius:16rpx;padding:0 22rpx}button[disabled]{opacity:.38}
.page{padding:24rpx 32rpx 56rpx}.row{display:flex;align-items:center;gap:16rpx}.between{justify-content:space-between}.grow{flex:1;min-width:0}.name{font-size:30rpx;font-weight:600;line-height:1.45}.muted{font-size:23rpx;color:#92969c}.num{font-variant-numeric:tabular-nums;font-feature-settings:"tnum"}.link{font-size:25rpx;font-weight:500;color:#34373b}.icon{display:block;width:36rpx;height:36rpx;flex-shrink:0}.icon.sm{width:28rpx;height:28rpx}.icon.lg{width:44rpx;height:44rpx}
.icon-button{display:flex;align-items:center;justify-content:center;width:80rpx;height:80rpx;flex-shrink:0;border-radius:50%}.icon-button:active{background:#eff0f2}.icon-button .icon{width:38rpx;height:38rpx}.icon-button.dark{background:#202226;color:#fff}.plus-icon{font-size:48rpx;font-weight:300;line-height:1;margin-top:-4rpx}.close-icon{font-size:42rpx;line-height:1;font-weight:300;color:#83888f}
.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}.field{margin-bottom:24rpx}.label{display:block;font-size:24rpx;color:#8a8e95;margin-bottom:12rpx;font-weight:400}input,textarea,picker .picker{box-sizing:border-box;width:100%;border:0;border-radius:12rpx;background:#f4f5f6;padding:20rpx 22rpx;color:#202226;font-size:28rpx}input{height:88rpx;padding-top:0;padding-bottom:0}textarea{height:190rpx;line-height:1.7}.picker{display:flex;align-items:center;justify-content:space-between;height:88rpx}.grid2{display:flex;gap:24rpx;flex-wrap:wrap}.grid2>.field{flex:1 1 280rpx;min-width:280rpx}.actions{display:flex;gap:14rpx}.actions button{flex:1;min-width:0}
.tag{display:inline-flex;align-items:center;gap:6rpx;border-radius:8rpx;padding:4rpx 10rpx;font-size:20rpx;line-height:1.5;background:#f0f1f2;color:#848990;white-space:nowrap}.tag-done{background:#eaf6ef;color:#28805a}.tag-pending{background:#fff4e6;color:#b78042}.tag-empty{background:#f4f5f6;color:#92969c}.dot{display:inline-block;width:9rpx;height:9rpx;background:#28805a;border-radius:50%;flex-shrink:0}.dot.orange{background:#cf9958}.dot.gray{background:#b2b6bc}
.error{margin:24rpx 0;padding:22rpx 24rpx;background:#fff3e5;border-radius:16rpx;color:#a7743e;font-size:25rpx;word-break:break-word}.error .link{margin-top:12rpx;color:#a7743e}.notice{font-size:23rpx;color:#93979d;line-height:1.6;margin:16rpx 0}.empty{padding:100rpx 24rpx;text-align:center;color:#92969c}.empty .name{color:#62676e;font-size:28rpx;font-weight:400}.empty .notice{margin:14rpx 0 28rpx}.empty-icon{display:flex;align-items:center;justify-content:center;height:64rpx;margin-bottom:28rpx;opacity:.6}.empty-icon .icon{width:52rpx;height:52rpx}.empty button{max-width:360rpx;margin:0 auto}.loading-line{text-align:center;padding:52rpx 0;font-size:23rpx;color:#a2a6ad}.divider{height:1rpx;background:#eff0f2;margin:24rpx 0}.press{opacity:.72}.toolbar{position:fixed;left:0;right:0;bottom:0;z-index:10;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));background:#fafafa;border-top:1rpx solid #eff0f2}.section-title{font-size:27rpx;font-weight:500;margin-bottom:24rpx}.spacer{height:24rpx}
/* 窄屏放不下两列时改为整行，避免标签被挤成两行。 */
@media (max-width:360px){.grid2>.field{flex-basis:100%}}

.muted,.label{color:#68737f}.icon-button{min-width:76rpx;min-height:76rpx}.loading-line{color:#68737f}.empty .name{font-size:30rpx;font-weight:500;color:#424d59}.empty .notice{color:#68737f}input::placeholder,textarea::placeholder{color:#8c959f}.error{font-size:24rpx;line-height:1.65}.toolbar{background:rgba(250,250,250,.98)}

/* Feedback is visible on contact; busy and confirmed states remain distinct. */
button{transition:background-color 100ms,transform 100ms,opacity 100ms}.button-pressed{transform:scale(.975);opacity:.85}.press{opacity:.82;background-color:rgba(99,128,108,.08)}.icon-button{transition:background-color 100ms,transform 100ms}.icon-button.press{background:#e2eae4;transform:scale(.92)}.row-pressed{background:#eaf0ec}.control-pressed{background:#dce7de;transform:scale(.97)}
