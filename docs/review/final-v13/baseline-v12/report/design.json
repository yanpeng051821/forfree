{
  "meta": {
    "name": "货记 · 个人商品记录与整理",
    "version": "1.2",
    "date": "2026-10-24",
    "basedOn": "用户本轮澄清 + docs/HANDOFF.md 2026-10-21日期范围商品导出决定",
    "status": "评审提案，尚未实现；本轮不改业务代码",
    "scope": "采购员自己记录、整理、比较各商家的商品数据，输出参考样式Excel",
    "excluded": [
      "采购单tab",
      "批次实体",
      "下单流程",
      "计入/取消/后补状态",
      "发送状态",
      "商户确认",
      "客户CRM",
      "客户报价/回选",
      "付款对账",
      "收货核对",
      "团队共享",
      "柜容预算",
      "独立Web工作台"
    ],
    "viewport": {
      "widths": [
        320,
        375,
        414
      ],
      "height": 812,
      "rpxPerPxAt375": 2
    },
    "drawingNotes": [
      "样例商品、店名、价格全部虚构；不展示任何联系方式数字",
      "保留系统相机，不画页内取景器或录音功能",
      "示意图不是运行中的小程序，按钮仅作导航或布局示意",
      "界面使用看货、商品、我的三个tab；整理是商品页的操作而非另一个业务系统"
    ],
    "changes": [
      "撤回旧v1.1订单层及旧handoff采购批次建议",
      "以单日/连续日期范围和商户选择导出，不要求选采购决定",
      "资料完整性、人工检查与AI确认分开，缺项允许导出",
      "所有参考商品记录默认包含，不从备注取消推断排除",
      "不再把90箱/70491.60采购假设结果作为商品表验收指标"
    ]
  },
  "principles": [
    "记录一次，复看补充，直接导出；减少手机到Excel的重复录入",
    "明确当前商户，连续录入不串店；缺少商户时先选店",
    "未知留空，不让AI根据外观猜价格、数量、体积",
    "资料检查不是采购决定；收藏是个人偏好，不代表要买",
    "保留记录日期和历史版本，不自动合并同货号记录",
    "参考Excel只指导字段与版式，不指导扩张业务流程",
    "复用现有个人数据、商户入口和公司模板，不为小功能建完整系统"
  ],
  "tabs": [
    {
      "id": "field",
      "name": "看货",
      "purpose": "现场按日期找商户并记录"
    },
    {
      "id": "library",
      "name": "商品",
      "purpose": "跨日期查找、复看、比较和导出"
    },
    {
      "id": "me",
      "name": "我的",
      "purpose": "个人资料、收藏、本机草稿与Excel格式"
    }
  ],
  "entities": [
    {
      "name": "商品记录",
      "id": "product.id",
      "fields": [
        "projectId",
        "supplier",
        "recordedDate",
        "version",
        "name",
        "itemNo",
        "photos",
        "unitPrice",
        "currency",
        "MOQ",
        "piecesPerCarton",
        "cartons",
        "recordedQuantity",
        "cartonSize",
        "cartonCbm",
        "barcode",
        "rawDescription",
        "notes",
        "favorite",
        "rating",
        "confirmed"
      ],
      "rules": [
        "复用现有结构，未知数字为null，显式0有效",
        "数量若明确填写含0优先；否则由箱数×每箱数量推导",
        "修改不改变首次保存日；同货号不同日期是独立记录",
        "已核对不等于所有字段齐全，不能自动改成采购决定"
      ]
    },
    {
      "name": "商户到访",
      "id": "project.id（复用）",
      "fields": [
        "supplier",
        "date",
        "contact",
        "booth"
      ],
      "rules": [
        "新品必须有当前商户上下文",
        "首期拆分店名/摊位输入并联想，不强制完整商户CRM迁移",
        "同名合并的已知限制需提示，独立商户ID待实际重名证据再评估"
      ]
    },
    {
      "name": "Excel格式",
      "id": "owner模板（复用）",
      "fields": [
        "companyHeader",
        "columns",
        "styles",
        "footerText"
      ],
      "rules": [
        "保存过的样式不被新默认值覆盖",
        "付款/唛头只作原始表尾文字，不解析成业务模型",
        "本次导出范围和文字不改变商品记录或永久模板"
      ]
    }
  ],
