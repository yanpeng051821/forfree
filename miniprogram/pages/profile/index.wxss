.profile-page{background:#f5f7f5;padding:24rpx 28rpx 220rpx}.profile-avatar-area{display:flex;flex-direction:column;align-items:center;padding:22rpx 0 38rpx}.avatar-picker{width:152rpx;height:152rpx;min-width:0;padding:0;margin:0;position:relative;background:#e3ebe5;border-radius:46rpx;overflow:visible;display:flex;align-items:center;justify-content:center}.avatar-image{width:152rpx;height:152rpx;border-radius:46rpx}.avatar-letter{font-size:60rpx;color:#597363;font-weight:500}.avatar-camera{position:absolute;right:-6rpx;bottom:-4rpx;width:46rpx;height:46rpx;border-radius:50%;border:5rpx solid #f5f7f5;background:#263b32;display:flex;align-items:center;justify-content:center}.avatar-camera image{width:23rpx;height:23rpx}.avatar-hint{font-size:22rpx;color:#88958c;margin-top:20rpx}.avatar-remove{background:transparent;color:#7e8b82;height:50rpx;font-size:22rpx;padding:0;margin-top:8rpx}.avatar-loading{position:absolute;inset:0;background:rgba(38,59,50,.55);border-radius:46rpx;color:#fff;font-size:23rpx;display:flex;align-items:center;justify-content:center}.profile-group{background:#fff;border-radius:22rpx;margin-bottom:22rpx;padding:0 24rpx}.profile-field{display:flex;align-items:center;gap:24rpx;min-height:108rpx;border-bottom:1rpx solid #eef2ef}.profile-field:last-child{border:0}.profile-field>text{flex:0 0 158rpx;font-size:26rpx;color:#66776b}.profile-field input{flex:1;min-width:0;padding:0;background:transparent;height:100rpx;font-size:28rpx;color:#263b32}.profile-field picker{flex:1;min-width:0}.profile-picker{height:108rpx;display:flex;justify-content:space-between;align-items:center;font-size:28rpx;color:#263b32;gap:16rpx}.profile-picker image{width:22rpx;height:22rpx;opacity:.4;transform:rotate(90deg)}.profile-help{font-size:22rpx;color:#88958c;margin:0 24rpx}.profile-save{background:rgba(245,247,245,.97);border-color:#e7ece8}.profile-save .primary{width:100%;background:#263b32;border-radius:18rpx}.profile-field:focus-within{border-bottom-color:#89a390}@media(max-width:360px){.profile-page{padding-left:20rpx;padding-right:20rpx}.profile-field>text{flex-basis:142rpx}.profile-group{padding-left:20rpx;padding-right:20rpx}}
