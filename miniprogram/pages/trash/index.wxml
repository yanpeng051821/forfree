<view wx:if="{{authenticated}}" class="page trash-page {{manageMode ? 'is-managing' : ''}}">
  <view class="trash-heading row between"><view><view class="name">回收站</view><view class="notice">恢复后回到原看货与记录日期</view></view><view class="manage-entry" bindtap="toggleManageMode" hover-class="control-pressed" hover-stay-time="80" aria-role="button" aria-label="批量管理回收站">{{manageMode ? '完成' : '管理'}}</view></view>
  <view class="search-box row"><image class="icon sm" src="/assets/icons/search.png" /><input value="{{query}}" bindinput="search" bindconfirm="reloadResults" disabled="{{mutationBusy}}" maxlength="200" confirm-type="search" placeholder="搜索商品或供应商" /><view wx:if="{{query}}" class="search-clear" bindtap="clearSearch" hover-class="press" hover-stay-time="80" aria-label="清除搜索">×</view></view>
  <view class="trash-count">{{loading ? '正在查找' : matchedCount + ' 件商品'}}</view>
  <view wx:if="{{manageMode}}" class="manage-hint row between"><text>已选 {{manageIds.length}} / 50</text><view bindtap="selectLoaded" hover-class="control-pressed" hover-stay-time="80" aria-role="button" aria-label="选择或取消当前已加载商品">选择已加载</view></view>
  <view wx:for="{{items}}" wx:key="id" class="trash-card {{item.manageSelected ? 'manage-selected' : ''}} {{item.actionBusy ? 'action-pending' : ''}}">
    <view class="trash-record row" data-id="{{item.id}}" bindtap="toggleManage" bindlongpress="productActions" hover-class="row-pressed" hover-stay-time="80">
      <view class="trash-thumb"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" lazy-load="{{true}}" /><image wx:else class="placeholder-icon" src="/assets/icons/image.png" /></view>
      <view class="grow"><view class="product-name">{{item.name}}</view><view class="trash-source">{{item.recordDateText}}</view><view wx:if="{{item.supplier}}" class="supplier">{{item.supplier}}</view><view class="trash-meta">{{item.deletedText}} 移入 · {{item.priceText}}</view></view>
      <view wx:if="{{manageMode}}" class="trash-check {{item.manageSelected ? 'selected' : ''}}" data-id="{{item.id}}" catchtap="toggleManage" hover-class="control-pressed" hover-stay-time="80" aria-role="checkbox" aria-checked="{{item.manageSelected}}" aria-label="选择商品"><view class="selection-circle"><text wx:if="{{item.manageSelected}}">✓</text></view></view>
    </view>
    <view wx:if="{{item.actionBusy}}" class="trash-pending" aria-live="polite">{{mutationId === item.id ? mutationLabel + '中…' : '请选择操作'}}</view>
    <view wx:if="{{!manageMode}}" class="trash-actions row"><button class="trash-icon" data-id="{{item.id}}" catchtap="restoreProduct" disabled="{{mutationBusy || loading || loadingMore}}" loading="{{mutationId === item.id && mutationLabel === '恢复'}}" aria-label="恢复商品" hover-class="trash-icon-pressed" hover-stay-time="80"><image wx:if="{{mutationId !== item.id || mutationLabel !== '恢复'}}" src="/assets/icons/restore.png" /></button><button class="trash-icon delete-icon" data-id="{{item.id}}" catchtap="deleteProduct" disabled="{{mutationBusy || loading || loadingMore}}" aria-label="永久删除商品" hover-class="trash-icon-pressed" hover-stay-time="80"><image src="/assets/icons/trash.png" /></button></view>
  </view>
  <view wx:if="{{loading}}" class="loading-line">加载中…</view>
  <view wx:if="{{!items.length && !loading && !error}}" class="empty"><view class="name">{{query ? '没有匹配的商品' : '回收站为空'}}</view><view class="notice">{{query ? '试试其他关键词' : '移入回收站的商品会显示在这里'}}</view></view>
  <view wx:if="{{hasMore || loadingMore}}" class="load-more" bindtap="loadMore" hover-class="press" hover-stay-time="80">{{loadingMore ? '加载中…' : '加载更多'}}</view>
  <view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="load" hover-class="press" hover-stay-time="80">刷新核查</view></view>
  <view wx:if="{{manageMode || mutationBusy}}" class="trash-dock"><view wx:if="{{mutationBusy}}" class="mutation-progress" aria-live="polite">{{mutationLabel}}中 · {{mutationDone}} / {{mutationTotal}}</view><view wx:if="{{manageMode}}" class="manage-strip"><text class="selection-count">已选 {{manageIds.length}} 件</text><view class="manage-actions row"><button class="primary small" bindtap="restoreSelected" disabled="{{!manageIds.length || mutationBusy || loading || loadingMore}}" loading="{{mutationBusy && mutationLabel === '恢复'}}" hover-class="button-pressed" hover-stay-time="80">恢复所选</button><button class="danger small" bindtap="deleteSelected" disabled="{{!manageIds.length || mutationBusy || loading || loadingMore}}" hover-class="button-pressed" hover-stay-time="80">永久删除</button></view></view></view>
</view>
